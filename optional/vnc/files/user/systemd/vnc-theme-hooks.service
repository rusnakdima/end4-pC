[Unit]
Description=VNC physical theme hooks
After=wayvnc-mirror.service
Wants=wayvnc-mirror.service

[Service]
Type=simple
KillMode=process
Environment=XDG_RUNTIME_DIR=@RUNTIME@
Environment=WAYLAND_DISPLAY=wayland-1
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=@RUNTIME@/bus
Environment=VNC_THEME_LOCK=1
ExecStart=@HOME@/.config/hypr/custom/scripts/vnc-theme-watch @RUNTIME@/wayvncctl-mirror
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
