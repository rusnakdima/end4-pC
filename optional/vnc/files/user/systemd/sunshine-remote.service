[Unit]
Description=Sunshine for hidden Hyprland (@HIDDEN_OUTPUT@)
After=pipewire.service

[Service]
ExecStartPre=/usr/bin/bash -c 'for i in $(seq 1 60); do [ -S @RUNTIME@/remote/wayland-1 ] && exit 0; sleep 1; done; exit 1'
Environment=XDG_RUNTIME_DIR=@RUNTIME@/remote
Environment=WAYLAND_DISPLAY=wayland-1
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=@RUNTIME@/bus
Environment=PULSE_SINK=hypr_remote
Environment=PULSE_SERVER=unix:@RUNTIME@/pulse/native
Environment=HOME=@HOME@
ExecStart=/usr/bin/sunshine %h/.config/sunshine/sunshine-remote.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
