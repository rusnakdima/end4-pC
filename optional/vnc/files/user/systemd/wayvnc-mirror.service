[Unit]
Description=WayVNC mirror of physical Hyprland (DP-1, interactive)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Environment=XDG_RUNTIME_DIR=@RUNTIME@
Environment=WAYLAND_DISPLAY=wayland-1
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=@RUNTIME@/bus
ExecStart=/usr/bin/wayvnc -C %h/.config/wayvnc/mirror.conf -a -r -f 30 -S @RUNTIME@/wayvncctl-mirror
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
