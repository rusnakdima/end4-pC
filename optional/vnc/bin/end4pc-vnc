#!/usr/bin/env python3
"""end4pc-vnc - user-level controller for the end4-pC WayVNC setup.

The controller is deliberately the only writer of the VNC configuration.  The
Settings page and the CLI call it; it validates, writes atomically and restarts
the user service when needed.  It never touches the end4-pC shell config and it
never starts a second compositor.
"""

from __future__ import annotations

import argparse
import getpass
import json
import os
import re
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
from datetime import datetime
from pathlib import Path

APP = "end4pc-vnc"
SERVICE = "wayvnc.service"

HOME = Path(os.environ.get("HOME") or Path.home())
XDG_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (HOME / ".config"))
XDG_RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
CONFIG_DIR = XDG_CONFIG_HOME / "end4-pC"
CONFIG_FILE = CONFIG_DIR / "vnc.json"
SECRET_FILE = CONFIG_DIR / "vnc.secret"
VNC_DIR = CONFIG_DIR / "vnc"
TLS_DIR = VNC_DIR / "tls"
CERT_FILE = TLS_DIR / "cert.pem"
KEY_FILE = TLS_DIR / "key.pem"
WAYVNC_CONF = VNC_DIR / "wayvnc.conf"
STATE_FILE = XDG_RUNTIME_DIR / "end4pc-vnc-state.json"
LOCK_FILE = XDG_RUNTIME_DIR / "end4pc-vnc.lock"

DEFAULTS = {
    "version": 1,
    "autostart": False,
    "desktopName": "end4-pC",
    "capture": {
        "mode": "all",  # all | single | headless
        "output": "",   # filled from the currently connected monitors
        "headless": {
            "width": 1920,
            "height": 1080,
            "refresh": 60,
            "scale": 1.0,
            "mirror": "",
        },
    },
    "encoding": {
        "maxFps": 30,
        "renderCursor": True,
        "gpu": False,
        "disableResizing": False,
    },
    "network": {
        "bindMode": "auto",  # auto | custom
        "address": "127.0.0.1",
        "port": 5900,
        "auth": True,
        "username": os.environ.get("USER") or HOME.name,
        "pam": False,
        "relaxEncryption": False,
        "allowBrokenCrypto": False,
    },
    "input": {
        "enabled": True,
        "seat": "",
        "matchHostKeyboard": True,
        "xkb": {"layout": "", "variant": "", "model": "", "options": "", "rules": ""},
    },
    "behavior": {
        "lockOnDisconnect": False,
        "inhibitIdle": False,
        "exitOnDisconnect": False,
        "logLevel": "warning",
    },
}

LOG_LEVELS = {"error", "warning", "info", "debug", "trace", "quiet"}
NAME_RE = re.compile(r"^[A-Za-z0-9_.:@-]+$")


# --------------------------------------------------------------------------
# small helpers
# --------------------------------------------------------------------------


def deep_merge(base: dict, patch: dict) -> dict:
    out = dict(base)
    for key, value in (patch or {}).items():
        if isinstance(value, dict) and isinstance(out.get(key), dict):
            out[key] = deep_merge(out[key], value)
        else:
            out[key] = value
    return out


def atomic_write(path: Path, text: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = _tempfile(path)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            try:
                os.unlink(tmp)
            except OSError:
                pass


def _tempfile(path: Path) -> tuple[int, str]:
    import tempfile

    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    return fd, name


def preferred_output() -> str:
    """Pick a connected physical output, preferring an external monitor."""
    try:
        available = physical_outputs()
    except SystemExit:
        return ""
    if not available:
        return ""
    for monitor in available:
        name = str(monitor.get("name", ""))
        if not re.match(r"^(eDP|LVDS|DSI)", name, re.IGNORECASE):
            return name
    return str(available[0].get("name", ""))


def load_config() -> dict:
    cfg = json.loads(json.dumps(DEFAULTS))
    if CONFIG_FILE.exists():
        try:
            raw = json.loads(CONFIG_FILE.read_text(encoding="utf-8") or "{}")
            cfg = deep_merge(cfg, raw)
        except (OSError, ValueError) as exc:
            raise SystemExit(f"cannot read {CONFIG_FILE}: {exc}")
    cfg["version"] = 1

    # Never send a stale/hardcoded port name to wayvnc: if the configured
    # output is no longer connected, fall back to a detected one.
    fallback = preferred_output()
    if fallback:
        capture = cfg.setdefault("capture", {})
        known = {str(m.get("name", "")) for m in physical_outputs()}
        if known and capture.get("output") not in known:
            capture["output"] = fallback
        headless = capture.setdefault("headless", {})
        if known and headless.get("mirror") not in known:
            headless["mirror"] = fallback
    return cfg


def save_config(cfg: dict) -> None:
    atomic_write(CONFIG_FILE, json.dumps(cfg, indent=2, sort_keys=True) + "\n")


def read_secret() -> str:
    try:
        return SECRET_FILE.read_text(encoding="utf-8").strip("\r\n")
    except OSError:
        return ""


def write_secret(secret: str) -> None:
    atomic_write(SECRET_FILE, secret + "\n")


def loopback(address: str) -> bool:
    return (address or "").strip() in {"127.0.0.1", "::1", "localhost"}


def run(cmd: list[str], *, check: bool = False, timeout: float = 15.0) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(
            cmd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            env=os.environ.copy(),
        )
        if check and proc.returncode != 0:
            raise RuntimeError((proc.stderr or proc.stdout).strip() or f"{cmd[0]} failed")
        return proc.returncode, proc.stdout, proc.stderr
    except FileNotFoundError:
        return 127, "", f"{cmd[0]}: not found"
    except subprocess.TimeoutExpired:
        return 124, "", f"{cmd[0]}: timed out"


def hypr_env() -> dict[str, str]:
    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR", str(XDG_RUNTIME_DIR))
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        root = Path(env["XDG_RUNTIME_DIR"]) / "hypr"
        try:
            candidates = sorted(root.iterdir(), key=lambda p: p.stat().st_mtime)
            if candidates:
                env["HYPRLAND_INSTANCE_SIGNATURE"] = candidates[-1].name
        except OSError:
            pass
    return env


def hyprctl(args: list[str]) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(
            ["hyprctl", *args],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=10,
            env=hypr_env(),
        )
        return proc.returncode, proc.stdout, proc.stderr
    except FileNotFoundError:
        return 127, "", "hyprctl: not found"
    except subprocess.TimeoutExpired:
        return 124, "", "hyprctl: timed out"


def hypr_eval(code: str) -> tuple[int, str, str]:
    return hyprctl(["eval", code])


def monitors(all_monitors: bool = False) -> list[dict]:
    args = ["monitors"]
    if all_monitors:
        args.append("all")
    args.append("-j")
    rc, out, _ = hyprctl(args)
    if rc != 0:
        return []
    try:
        data = json.loads(out or "[]")
        return data if isinstance(data, list) else []
    except ValueError:
        return []


def physical_outputs() -> list[dict]:
    return [m for m in monitors() if not m.get("disabled") and not str(m.get("name", "")).startswith("HEADLESS")]


def wayvncctl(args: list[str], timeout: float = 5.0) -> tuple[int, str, str]:
    if not shutil.which("wayvncctl"):
        return 127, "", "wayvncctl: not found"
    return run(["wayvncctl", "--json", *args], timeout=timeout)


def service_state() -> tuple[bool, bool, str]:
    rc, out, _ = run(["systemctl", "--user", "is-active", SERVICE])
    active = rc == 0 and out.strip() == "active"
    rc2, out2, _ = run(["systemctl", "--user", "is-enabled", SERVICE])
    enabled = rc2 == 0 and out2.strip() in {"enabled", "enabled-runtime"}
    rc3, out3, _ = run(["systemctl", "--user", "show", "-p", "ActiveState", "-p", "SubState", "--value", SERVICE])
    state = " ".join(x.strip() for x in out3.splitlines() if x.strip()) if rc3 == 0 else "unknown"
    return active, enabled, state


def systemctl(action: str) -> tuple[bool, str]:
    if action not in {"start", "stop", "restart", "enable", "disable"}:
        raise ValueError(action)
    if action in {"start", "restart"}:
        # A previous failed configuration can leave the unit in start-limit-hit.
        run(["systemctl", "--user", "reset-failed", SERVICE])
    rc, out, err = run(["systemctl", "--user", action, SERVICE])
    if rc != 0:
        return False, (err or out).strip() or f"systemctl {action} failed"
    return True, ""


def service_installed() -> bool:
    return Path(HOME / ".config/systemd/user" / SERVICE).exists()


def fingerprint() -> str:
    if not CERT_FILE.exists() or not shutil.which("openssl"):
        return ""
    rc, out, _ = run(
        ["openssl", "x509", "-in", str(CERT_FILE), "-noout", "-fingerprint", "-sha256"],
        timeout=5,
    )
    if rc != 0:
        return ""
    return out.strip().split("=", 1)[-1].strip()


# --------------------------------------------------------------------------
# validation and generation
# --------------------------------------------------------------------------


def validate(cfg: dict, secret: str) -> list[str]:
    errors: list[str] = []
    cap = cfg.get("capture") or {}
    mode = cap.get("mode")
    if mode not in {"all", "single", "headless"}:
        errors.append("capture.mode must be all, single or headless")
    if mode == "single":
        out = str(cap.get("output") or "").strip()
        if not out or not NAME_RE.match(out):
            errors.append("capture.output is required for single-monitor mode")
    if mode == "headless":
        # A mirrored headless output is hidden from wayvnc's output list on
        # Hyprland 0.57, so it cannot be captured.  Keep the config key for
        # completeness but refuse it instead of starting a broken service.
        errors.append("virtual mirror is not supported by wayvnc on Hyprland; use all monitors or a single physical output")

    enc = cfg.get("encoding") or {}
    try:
        fps = int(enc.get("maxFps", 30))
        if fps < 1 or fps > 120:
            errors.append("encoding.maxFps must be 1-120")
    except (TypeError, ValueError):
        errors.append("encoding.maxFps must be a number")

    net = cfg.get("network") or {}
    mode = str(net.get("bindMode") or "auto")
    address = str(net.get("address") or "").strip()
    if mode not in ("auto", "custom"):
        errors.append("network.bindMode must be auto or custom")
    if mode == "custom" and not address:
        errors.append("network.address is required in custom bind mode")
    try:
        port = int(net.get("port", 5900))
        if port < 1024 or port > 65535:
            errors.append("network.port must be 1024-65535")
    except (TypeError, ValueError):
        errors.append("network.port must be a number")
    auth = bool(net.get("auth"))
    pam = bool(net.get("pam"))
    if not auth and (mode == "auto" or not loopback(address)):
        errors.append("authentication must stay enabled unless the bind address is loopback")
    if auth:
        if not pam and not secret:
            errors.append("a VNC password is required when authentication is enabled")
        if not pam and secret:
            if secret != secret.strip() or "\n" in secret or "\r" in secret:
                errors.append("the VNC password cannot start/end with whitespace or contain newlines")
            if len(secret) > 256:
                errors.append("the VNC password is too long")
        if not shutil.which("openssl"):
            errors.append("openssl is required to generate the TLS certificate")

    inp = cfg.get("input") or {}
    xkb = inp.get("xkb") or {}
    for key in ("layout", "variant", "model", "options", "rules"):
        value = xkb.get(key, "")
        if value is not None and not isinstance(value, str):
            errors.append(f"input.xkb.{key} must be a string")
    seat = str(inp.get("seat") or "")
    if seat and not NAME_RE.match(seat):
        errors.append("input.seat contains unsupported characters")

    beh = cfg.get("behavior") or {}
    log_level = str(beh.get("logLevel") or "warning")
    if log_level not in LOG_LEVELS:
        errors.append("behavior.logLevel is invalid")

    name = str(cfg.get("desktopName") or "").strip()
    if not name:
        errors.append("desktopName is required")
    return errors


def ensure_tls(cfg: dict) -> None:
    """Generate a self-signed certificate when auth is on and none exists."""
    if not bool((cfg.get("network") or {}).get("auth")):
        return
    TLS_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(TLS_DIR, 0o700)
    if CERT_FILE.exists() and KEY_FILE.exists():
        return
    if not shutil.which("openssl"):
        raise RuntimeError("openssl is required to generate the TLS certificate")
    address = str((cfg.get("network") or {}).get("address") or "127.0.0.1")
    san = ["DNS:localhost", "IP:127.0.0.1", "IP:::1"]
    if re.match(r"^\d{1,3}(\.\d{1,3}){3}$", address):
        san.append(f"IP:{address}")
    elif NAME_RE.match(address):
        san.append(f"DNS:{address}")
    cmd = [
        "openssl",
        "req",
        "-x509",
        "-newkey",
        "rsa:4096",
        "-sha256",
        "-days",
        "3650",
        "-nodes",
        "-keyout",
        str(KEY_FILE),
        "-out",
        str(CERT_FILE),
        "-subj",
        "/CN=end4pc-vnc",
        "-addext",
        "subjectAltName=" + ",".join(dict.fromkeys(san)),
    ]
    rc, out, err = run(cmd, timeout=60)
    if rc != 0:
        raise RuntimeError((err or out).strip() or "openssl failed")
    os.chmod(KEY_FILE, 0o600)
    os.chmod(CERT_FILE, 0o600)


def write_wayvnc_conf(cfg: dict) -> None:
    net = cfg.get("network") or {}
    lines = [
        "use_relative_paths=false",
        f"enable_auth={'true' if net.get('auth') else 'false'}",
    ]
    if net.get("auth"):
        lines += [
            f"certificate_file={CERT_FILE}",
            f"private_key_file={KEY_FILE}",
            f"username={str(net.get('username') or '').strip()}",
        ]
        if net.get("pam"):
            lines.append("enable_pam=true")
        else:
            lines.append(f"password={read_secret()}")
        if net.get("relaxEncryption"):
            lines.append("relax_encryption=true")
        if net.get("allowBrokenCrypto"):
            lines.append("allow_broken_crypto=true")
    inp = cfg.get("input") or {}
    if inp.get("matchHostKeyboard"):
        rc, layout, _ = hyprctl(["getoption", "input:kb_layout", "-j"])
        rc2, options, _ = hyprctl(["getoption", "input:kb_options", "-j"])
        try:
            layout = json.loads(layout).get("str", "") if rc == 0 else ""
        except ValueError:
            layout = ""
        try:
            options = json.loads(options).get("str", "") if rc2 == 0 else ""
        except ValueError:
            options = ""
        if layout:
            lines.append(f"xkb_layout={layout}")
        if options:
            lines.append(f"xkb_options={options}")
    else:
        xkb = inp.get("xkb") or {}
        for key in ("layout", "variant", "model", "options", "rules"):
            value = str(xkb.get(key) or "").strip()
            if value:
                lines.append(f"xkb_{key}={value}")
    atomic_write(WAYVNC_CONF, "\n".join(lines) + "\n")


def wayvnc_args(cfg: dict) -> list[str]:
    cap = cfg.get("capture") or {}
    enc = cfg.get("encoding") or {}
    inp = cfg.get("input") or {}
    beh = cfg.get("behavior") or {}
    args = ["-C", str(WAYVNC_CONF)]
    mode = cap.get("mode")
    if mode == "all":
        args.append("-a")
    elif mode == "single":
        args += ["-o", str(cap.get("output"))]
    elif mode == "headless":
        name = load_state().get("headless")
        if not name:
            raise RuntimeError("headless output is not prepared")
        args += ["-o", name]
    if enc.get("renderCursor"):
        args.append("-r")
    args += ["-f", str(int(enc.get("maxFps", 30)))]
    if enc.get("gpu"):
        args.append("-g")
    if enc.get("disableResizing"):
        args.append("-R")
    if not inp.get("enabled"):
        args.append("-d")
    if inp.get("seat"):
        args += ["-s", str(inp["seat"])]
    if cfg.get("desktopName"):
        args += ["-n", str(cfg["desktopName"])]
    if beh.get("exitOnDisconnect"):
        args.append("-e")
    if beh.get("logLevel"):
        args += ["-L", str(beh["logLevel"])]
    port = int((cfg.get("network") or {}).get("port", 5900))
    listen = listen_addresses(cfg)
    if not listen:
        raise RuntimeError("no bind addresses were detected")
    for addr in listen:
        host = f"[{addr}]" if ":" in addr else addr
        args.append(f"{host}:{port}")
    return args


# --------------------------------------------------------------------------
# headless output
# --------------------------------------------------------------------------


def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text(encoding="utf-8") or "{}")
    except (OSError, ValueError):
        return {}


def save_state(state: dict) -> None:
    atomic_write(STATE_FILE, json.dumps(state, sort_keys=True) + "\n", 0o600)


def headless_names() -> list[str]:
    return [m.get("name") for m in monitors(all_monitors=True) if str(m.get("name", "")).startswith("HEADLESS")]


def mirror_lua(name: str, cfg: dict) -> str:
    h = (cfg.get("capture") or {}).get("headless") or {}
    try:
        w = int(h.get("width", 1920))
        hgt = int(h.get("height", 1080))
        refresh = int(h.get("refresh", 60))
        scale = float(h.get("scale", 1.0))
    except (TypeError, ValueError):
        w, hgt, refresh, scale = 1920, 1080, 60, 1.0
    target = str(h.get("mirror") or "").strip() or focused_output()
    if not NAME_RE.match(name) or not NAME_RE.match(target):
        raise RuntimeError("invalid headless output name")
    return (
        f'hl.monitor({{ output = "{name}", mode = "{w}x{hgt}@{refresh}", '
        f'position = "0x0", scale = {scale}, mirror = "{target}" }})'
    )


def focused_output() -> str:
    for m in monitors():
        if m.get("focused"):
            return str(m.get("name"))
    outs = physical_outputs()
    return str(outs[0]["name"]) if outs else ""


def ensure_headless(cfg: dict) -> str:
    state = load_state()
    names = headless_names()
    name = state.get("headless")
    if name not in names:
        before = set(names)
        rc, out, err = hyprctl(["output", "create", "headless"])
        if rc != 0:
            raise RuntimeError((err or out).strip() or "cannot create headless output")
        for _ in range(50):
            new = [n for n in headless_names() if n not in before]
            if new:
                name = new[0]
                break
            time.sleep(0.1)
        if not name:
            raise RuntimeError("headless output was created but never appeared")
    rc, out, err = hypr_eval(mirror_lua(name, cfg))
    if rc != 0:
        raise RuntimeError((err or out).strip() or "cannot mirror headless output")
    state["headless"] = name
    save_state(state)
    return name


def disable_headless() -> None:
    state = load_state()
    name = state.get("headless")
    if not name:
        return
    if name in headless_names():
        hypr_eval(f'hl.monitor({{ output = "{name}", disabled = true }})')
        # hyprctl output remove refuses mirrored virtual outputs on some
        # Hyprland versions.  A disabled output is inert and is re-used on
        # the next start; it disappears on the next compositor start.
        hyprctl(["output", "remove", name])
    state.pop("headless", None)
    save_state(state)


# --------------------------------------------------------------------------
# status
# --------------------------------------------------------------------------


# Address classification for connected peers.  This is read-only telemetry:
# it never changes how wayvnc binds.
PRIVATE_NETWORKS = (
    "10.", "172.16.", "172.17.", "172.18.", "172.19.", "172.20.",
    "172.21.", "172.22.", "172.23.", "172.24.", "172.25.", "172.26.",
    "172.27.", "172.28.", "172.29.", "172.30.", "172.31.", "192.168.",
)


def _same_subnet(a: str, b: str, prefix: int = 24) -> bool:
    try:
        import ipaddress
        net_a = ipaddress.ip_network(f"{a}/{prefix}", strict=False)
        return ipaddress.ip_address(b) in net_a
    except ValueError:
        return False


def classify_peer(address: str, detected: list[dict] | None = None) -> tuple[str, str]:
    """Return (kind, interface) for a connected client's address."""
    addr = (address or "").strip().strip("[]")
    if not addr:
        return "unknown", ""
    if addr == "::1" or addr.startswith("127."):
        return "loopback", "lo"
    # Tailscale uses 100.64.0.0/10 (CGNAT); addresses in that range that are
    # also detected locally are reported as tailscale by detected_addresses().
    for entry in detected if detected is not None else detected_addresses():
        if entry["kind"] == "tailscale" and _same_subnet(addr, entry["address"], 10):
            return "tailscale", entry["interface"]
        if entry["kind"] == "lan" and _same_subnet(addr, entry["address"]):
            return "lan", entry["interface"]
    if addr.startswith("100."):
        return "tailscale", "tailscale0"
    if addr.startswith(PRIVATE_NETWORKS):
        return "lan", ""
    if ":" in addr:
        return "vpn", ""
    return "remote", ""


def enrich_clients(raw: list[dict]) -> list[dict]:
    """Add monitoring fields to wayvnc's client list.

    wayvnc only reports id, address, username and seat.  We derive the access
    kind (loopback / LAN / Tailscale) and remember when each id was first
    seen so the Settings page can show a stable "connected since" value
    across its 5-second status polls.
    """
    state = load_state()
    seen = state.get("clientSeen") if isinstance(state.get("clientSeen"), dict) else {}
    now = time.time()
    live_ids: set[str] = set()
    result: list[dict] = []
    detected = detected_addresses()

    for client in raw:
        if not isinstance(client, dict):
            continue
        cid = str(client.get("id") or "")
        live_ids.add(cid)
        since = seen.get(cid)
        if not isinstance(since, (int, float)) or since <= 0 or since > now:
            since = now
            seen[cid] = since
        address = str(client.get("address") or "")
        kind, interface = classify_peer(address, detected)
        item = dict(client)
        item.update({
            "id": cid,
            "address": address,
            "username": str(client.get("username") or "") or None,
            "seat": str(client.get("seat") or "") or None,
            "kind": kind,
            "interface": interface,
            "connectedSince": datetime.fromtimestamp(since).astimezone().isoformat(timespec="seconds"),
            "uptimeSeconds": max(0, int(now - since)),
        })
        result.append(item)

    for stale in [key for key in seen if key not in live_ids]:
        del seen[stale]
    if state.get("clientSeen") != seen:
        state["clientSeen"] = seen
        try:
            save_state(state)
        except OSError:
            pass
    return result


def clients() -> list[dict]:
    rc, out, _ = wayvncctl(["client-list"])
    if rc != 0:
        return []
    try:
        data = json.loads(out or "[]")
    except ValueError:
        return []
    if isinstance(data, dict):
        data = data.get("clients", [])
    if not isinstance(data, list):
        return []
    return enrich_clients(data)


def output_list() -> list[dict]:
    rc, out, _ = wayvncctl(["output-list"])
    if rc != 0:
        return []
    try:
        data = json.loads(out or "[]")
    except ValueError:
        return []
    if isinstance(data, dict):
        data = data.get("outputs", [])
    return data if isinstance(data, list) else []


LAN_IFACE_PREFIXES = ("en", "eth", "wl", "wlan")
VIRTUAL_IFACE_PREFIXES = (
    "lo", "tailscale", "docker", "veth", "virbr", "br-", "podman",
    "vmnet", "tun", "wg", "zt",
)


def detected_addresses() -> list[dict]:
    """Return loopback, physical Ethernet/Wi-Fi and Tailscale IPv4 addresses."""
    out: list[dict] = []
    seen: set[str] = set()

    def add(address: str, kind: str, interface: str) -> None:
        address = (address or "").strip()
        if not address or address in seen:
            return
        seen.add(address)
        out.append({"address": address, "kind": kind, "interface": interface})

    add("127.0.0.1", "loopback", "lo")

    rc, text, _ = run(["ip", "-j", "addr", "show"], timeout=5)
    if rc == 0:
        try:
            for iface in json.loads(text):
                name = str(iface.get("ifname") or "")
                if not name or name.startswith(VIRTUAL_IFACE_PREFIXES):
                    continue
                if not name.startswith(LAN_IFACE_PREFIXES):
                    continue
                for info in iface.get("addr_info", []):
                    if info.get("family") != "inet":
                        continue
                    local = str(info.get("local") or "")
                    if local.startswith("169.254."):
                        continue
                    add(local, "lan", name)
        except ValueError:
            pass

    if shutil.which("tailscale"):
        rc, text, _ = run(["tailscale", "ip", "-4"], timeout=5)
        if rc == 0:
            for line in text.splitlines():
                add(line.strip(), "tailscale", "tailscale0")

    # Fallback when the tailscale CLI is unavailable but the interface exists.
    if not any(entry["kind"] == "tailscale" for entry in out):
        rc2, text2, _ = run(["ip", "-j", "addr", "show", "dev", "tailscale0"], timeout=5)
        if rc2 == 0:
            try:
                ifaces = json.loads(text2)
            except ValueError:
                ifaces = []
            for iface in ifaces:
                for info in iface.get("addr_info", []):
                    if info.get("family") == "inet":
                        add(str(info.get("local") or ""), "tailscale", "tailscale0")

    return out


def listen_addresses(cfg: dict) -> list[str]:
    network = cfg.get("network") or {}
    mode = str(network.get("bindMode") or "auto")
    if mode == "custom":
        address = str(network.get("address") or "").strip()
        return [address] if address else []
    return [entry["address"] for entry in detected_addresses()]


def addresses() -> list[str]:
    return [entry["address"] for entry in detected_addresses()]


def status_payload() -> dict:
    cfg = load_config()
    secret = read_secret()
    active, enabled, state = service_state()
    monitors_all = monitors(all_monitors=True)
    normal = [m for m in monitors_all if not m.get("disabled")]
    errors = validate(cfg, secret)
    if not shutil.which("wayvnc"):
        errors.append("wayvnc is not installed")
    if not service_installed():
        errors.append("wayvnc.service is not installed for this user")
    tls_ready = CERT_FILE.exists() and KEY_FILE.exists()
    current = ""
    try:
        name = load_state().get("headless")
        if name in [m.get("name") for m in monitors_all]:
            current = name
    except Exception:
        current = ""
    return {
        "config": cfg,
        "hasPassword": bool(secret),
        "tlsReady": tls_ready,
        "fingerprint": fingerprint(),
        "serviceActive": active,
        "serviceEnabled": enabled,
        "serviceState": state,
        "serviceInstalled": service_installed(),
        "helper": str(Path(__file__).resolve()),
        "hostname": socket.gethostname(),
        "version": wayvnc_version(),
        "clients": clients(),
        "wayvncOutputs": output_list(),
        "monitors": normal,
        "outputs": [
            {
                "name": m.get("name"),
                "width": m.get("width"),
                "height": m.get("height"),
                "refresh": m.get("refreshRate"),
                "focused": bool(m.get("focused")),
                "disabled": bool(m.get("disabled")),
                "headless": str(m.get("name", "")).startswith("HEADLESS"),
                "mirrorOf": m.get("mirrorOf"),
            }
            for m in monitors_all
        ],
        "headless": current,
        "detected": detected_addresses(),
        "listenAddresses": listen_addresses(cfg),
        "addresses": addresses(),
        "errors": errors,
    }


def wayvnc_version() -> dict:
    rc, out, _ = wayvncctl(["version"])
    if rc != 0:
        return {}
    try:
        return json.loads(out or "{}")
    except ValueError:
        return {}


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------


def cmd_status(_args: argparse.Namespace) -> int:
    print(json.dumps(status_payload(), indent=2))
    return 0


def read_stdin_line() -> str:
    line = sys.stdin.readline()
    if not line:
        line = sys.stdin.read()
    return line.rstrip("\r\n")


def apply_patch(patch: dict) -> dict:
    cfg = deep_merge(load_config(), patch)
    secret = read_secret()
    errors = validate(cfg, secret)
    if errors:
        return {"ok": False, "error": "; ".join(errors)}
    try:
        if (cfg.get("network") or {}).get("auth"):
            ensure_tls(cfg)
        write_wayvnc_conf(cfg)
    except RuntimeError as exc:
        return {"ok": False, "error": str(exc)}
    old = load_config()
    save_config(cfg)
    was_autostart = bool(old.get("autostart"))
    if bool(cfg.get("autostart")) != was_autostart:
        action = "enable" if cfg.get("autostart") else "disable"
        ok, err = systemctl(action)
        if not ok:
            return {"ok": False, "error": err}
    if cfg.get("capture", {}).get("mode") != "headless":
        disable_headless()
        # Virtual outputs left behind by an old experiment must not stay in
        # the session: they get their own lock surfaces and can steal focus
        # from the physical monitors while the session is locked.
        for name in headless_names():
            hyprctl(["output", "remove", name])
    active, _, _ = service_state()
    restarted = False
    if active:
        ok, err = systemctl("restart")
        if not ok:
            return {"ok": False, "error": err}
        restarted = True
    return {"ok": True, "restarted": restarted, "status": status_payload()}


def cmd_apply(_args: argparse.Namespace) -> int:
    raw = sys.stdin.readline()
    if not raw.strip():
        raw = sys.stdin.read()
    if not raw.strip():
        print(json.dumps({"ok": False, "error": "empty settings payload"}))
        return 2
    try:
        patch = json.loads(raw)
    except ValueError as exc:
        print(json.dumps({"ok": False, "error": f"invalid JSON: {exc}"}))
        return 2
    result = apply_patch(patch)
    print(json.dumps(result, indent=2))
    return 0 if result.get("ok") else 2


def cmd_init(_args: argparse.Namespace) -> int:
    cfg = load_config()
    if not SECRET_FILE.exists():
        write_secret(secrets.token_urlsafe(18))
    if (cfg.get("network") or {}).get("auth"):
        ensure_tls(cfg)
    write_wayvnc_conf(cfg)
    save_config(cfg)
    print(json.dumps({"ok": True, "config": str(CONFIG_FILE), "secret": str(SECRET_FILE), "fingerprint": fingerprint()}, indent=2))
    return 0


def cmd_password(_args: argparse.Namespace) -> int:
    secret = read_stdin_line()
    if not secret:
        print(json.dumps({"ok": False, "error": "password cannot be empty"}))
        return 2
    if secret != secret.strip() or "\n" in secret or "\r" in secret:
        print(json.dumps({"ok": False, "error": "password cannot contain newlines or surrounding whitespace"}))
        return 2
    write_secret(secret)
    cfg = load_config()
    if (cfg.get("network") or {}).get("auth"):
        ensure_tls(cfg)
        write_wayvnc_conf(cfg)
    active, _, _ = service_state()
    if active:
        ok, err = systemctl("restart")
        if not ok:
            print(json.dumps({"ok": False, "error": err}))
            return 1
    print(json.dumps({"ok": True, "status": status_payload()}, indent=2))
    return 0


def cmd_cert(args: argparse.Namespace) -> int:
    if args.action != "regenerate":
        print(json.dumps({"ok": False, "error": "usage: cert regenerate"}))
        return 2
    for path in (CERT_FILE, KEY_FILE):
        if path.exists():
            backup = path.with_suffix(path.suffix + ".bak")
            try:
                os.replace(path, backup)
            except OSError:
                pass
    cfg = load_config()
    ensure_tls(cfg)
    write_wayvnc_conf(cfg)
    active, _, _ = service_state()
    if active:
        systemctl("restart")
    print(json.dumps({"ok": True, "fingerprint": fingerprint(), "status": status_payload()}, indent=2))
    return 0


def cmd_service(args: argparse.Namespace) -> int:
    action = args.action
    if action in {"autostart-on", "autostart-off"}:
        action = "enable" if action.endswith("on") else "disable"
    ok, err = systemctl(action)
    if not ok:
        print(json.dumps({"ok": False, "error": err}))
        return 1
    cfg = load_config()
    if action in {"enable", "disable"}:
        cfg["autostart"] = action == "enable"
        save_config(cfg)
    print(json.dumps({"ok": True, "status": status_payload()}, indent=2))
    return 0


def cmd_clients(_args: argparse.Namespace) -> int:
    print(json.dumps({"clients": clients()}, indent=2))
    return 0


def cmd_outputs(_args: argparse.Namespace) -> int:
    print(json.dumps({"monitors": monitors(all_monitors=True), "wayvncOutputs": output_list()}, indent=2))
    return 0


def cmd_output_set(args: argparse.Namespace) -> int:
    if not NAME_RE.match(args.name):
        print(json.dumps({"ok": False, "error": "invalid output name"}))
        return 2
    rc, out, err = wayvncctl(["output-set", args.name])
    if rc != 0:
        print(json.dumps({"ok": False, "error": (err or out).strip() or "output-set failed"}))
        return 1
    print(json.dumps({"ok": True, "output": args.name}))
    return 0


def cmd_desktop_name(args: argparse.Namespace) -> int:
    if not args.name.strip():
        print(json.dumps({"ok": False, "error": "desktop name cannot be empty"}))
        return 2
    rc, out, err = wayvncctl(["set-desktop-name", args.name])
    if rc != 0:
        print(json.dumps({"ok": False, "error": (err or out).strip() or "set-desktop-name failed"}))
        return 1
    cfg = load_config()
    cfg["desktopName"] = args.name
    save_config(cfg)
    print(json.dumps({"ok": True, "desktopName": args.name}))
    return 0


def cmd_disconnect(args: argparse.Namespace) -> int:
    rc, out, err = wayvncctl(["client-disconnect", args.id])
    if rc != 0:
        print(json.dumps({"ok": False, "error": (err or out).strip() or "client-disconnect failed"}))
        return 1
    print(json.dumps({"ok": True}))
    return 0


def cmd_disconnect_all(_args: argparse.Namespace) -> int:
    current = clients()
    if not current:
        print(json.dumps({"ok": True, "disconnected": 0}))
        return 0
    failed: list[str] = []
    for client in current:
        rc, out, err = wayvncctl(["client-disconnect", str(client.get("id") or "")])
        if rc != 0:
            failed.append(str(client.get("id") or "?"))
    if failed:
        print(json.dumps({"ok": False, "error": "failed to disconnect: " + ", ".join(failed), "disconnected": len(current) - len(failed)}))
        return 1
    print(json.dumps({"ok": True, "disconnected": len(current)}))
    return 0


def cmd_log(args: argparse.Namespace) -> int:
    rc, out, err = run(["journalctl", "--user", "-u", SERVICE, "-n", str(args.lines), "--no-pager"], timeout=10)
    if rc != 0:
        print((err or out).strip())
        return 1
    print(out)
    return 0


def cmd_validate(_args: argparse.Namespace) -> int:
    cfg = load_config()
    errors = validate(cfg, read_secret())
    print(json.dumps({"ok": not errors, "errors": errors}, indent=2))
    return 0 if not errors else 1


def wait_for_hyprland(timeout: float = 30.0) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if monitors():
            return True
        time.sleep(1.0)
    return False


def cmd_run(_args: argparse.Namespace) -> int:
    cfg = load_config()
    errors = validate(cfg, read_secret())
    if errors:
        print(f"{APP}: refusing to start: {'; '.join(errors)}", file=sys.stderr)
        return 1
    if not shutil.which("wayvnc"):
        print(f"{APP}: wayvnc is not installed", file=sys.stderr)
        return 1
    if not wait_for_hyprland():
        print(f"{APP}: the Hyprland session did not expose any outputs", file=sys.stderr)
        return 1
    if str((cfg.get("network") or {}).get("bindMode") or "auto") == "auto" and shutil.which("tailscale"):
        for _ in range(10):
            if any(entry["kind"] == "tailscale" for entry in detected_addresses()):
                break
            time.sleep(1)
    ensure_tls(cfg)
    write_wayvnc_conf(cfg)
    headless = None
    if (cfg.get("capture") or {}).get("mode") == "headless":
        headless = ensure_headless(cfg)
    else:
        # See cmd_apply: no stray virtual outputs in a physical capture mode.
        for name in headless_names():
            hyprctl(["output", "remove", name])
    cmd = [shutil.which("wayvnc"), *wayvnc_args(cfg)]
    stop_event = threading.Event()
    watcher: threading.Thread | None = None
    beh = cfg.get("behavior") or {}
    if beh.get("lockOnDisconnect") or beh.get("inhibitIdle"):
        watcher = threading.Thread(target=watch_clients, args=(cfg, stop_event), daemon=True)
        watcher.start()
    proc = subprocess.Popen(cmd)
    rc = 0

    def stop(_signum=None, _frame=None):
        stop_event.set()
        if proc.poll() is None:
            proc.terminate()
        if watcher is not None:
            watcher.join(timeout=2)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        rc = proc.wait()
    finally:
        stop_event.set()
        if watcher is not None:
            watcher.join(timeout=2)
        if headless:
            disable_headless()
    return rc


def watch_clients(cfg: dict, stop_event: threading.Event) -> None:
    beh = cfg.get("behavior") or {}
    inhibitor: subprocess.Popen | None = None
    active = False

    def set_inhibitor(on: bool) -> None:
        nonlocal inhibitor
        if on and inhibitor is None and beh.get("inhibitIdle"):
            try:
                inhibitor = subprocess.Popen(
                    [
                        "systemd-inhibit",
                        "--what=idle",
                        "--who=end4pc-vnc",
                        "--why=VNC client connected",
                        "--mode=block",
                        "sleep",
                        "infinity",
                    ],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            except OSError:
                inhibitor = None
        elif not on and inhibitor is not None:
            inhibitor.terminate()
            try:
                inhibitor.wait(timeout=2)
            except subprocess.TimeoutExpired:
                inhibitor.kill()
            inhibitor = None

    try:
        while not stop_event.is_set():
            proc = subprocess.Popen(
                ["wayvncctl", "--json", "--wait", "--reconnect", "event-receive"],
                stdout=subprocess.PIPE,
                text=True,
            )
            try:
                assert proc.stdout is not None
                for line in proc.stdout:
                    if stop_event.is_set():
                        break
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        event = json.loads(line)
                    except ValueError:
                        continue
                    params = event.get("params") or {}
                    count = params.get("connection_count")
                    if count is None:
                        continue
                    count = int(count)
                    if count > 0 and not active:
                        active = True
                        set_inhibitor(True)
                    elif count == 0 and active:
                        active = False
                        set_inhibitor(False)
                        if beh.get("lockOnDisconnect") and not stop_event.is_set():
                            run(["loginctl", "lock-session"], timeout=5)
            finally:
                if proc.poll() is None:
                    proc.terminate()
                    try:
                        proc.wait(timeout=2)
                    except subprocess.TimeoutExpired:
                        proc.kill()
            if stop_event.is_set():
                break
            time.sleep(1)
    finally:
        set_inhibitor(False)


# --------------------------------------------------------------------------
# interactive configurator (works over ssh -t)
# --------------------------------------------------------------------------


def _menu_clear() -> None:
    if sys.stdout.isatty():
        print("\033[2J\033[H", end="")


def _menu_input(prompt: str, default: str = "") -> str:
    suffix = f" [{default}]" if default != "" else ""
    try:
        value = input(f"{prompt}{suffix}: ").strip()
    except EOFError:
        print()
        raise SystemExit(0)
    if value == "-":
        return ""
    return value or default


def _menu_confirm(prompt: str, default: bool = False) -> bool:
    raw = _menu_input(prompt + (" [Y/n]" if default else " [y/N]"), "y" if default else "n")
    return raw.lower() in {"y", "yes"}


def _menu_int(prompt: str, current: int, low: int, high: int) -> int:
    while True:
        raw = _menu_input(prompt, str(current))
        try:
            value = int(raw)
        except ValueError:
            print("Enter a number.")
            continue
        if low <= value <= high:
            return value
        print(f"Enter a value between {low} and {high}.")


def _menu_bool(prompt: str, current: bool) -> bool:
    return _menu_confirm(f"{prompt} (currently {'on' if current else 'off'})", current)


def _menu_pause() -> None:
    try:
        input("\nPress Enter to continue...")
    except EOFError:
        raise SystemExit(0)


def _auth_summary(cfg: dict) -> str:
    net = cfg.get("network") or {}
    if not net.get("auth"):
        return "disabled"
    if net.get("pam"):
        return "TLS + PAM (system password)"
    return "TLS + VNC password"


def _print_summary(cfg: dict) -> None:
    active, enabled, state = service_state()
    net = cfg.get("network") or {}
    cap = cfg.get("capture") or {}
    enc = cfg.get("encoding") or {}
    inp = cfg.get("input") or {}
    listen = listen_addresses(cfg)
    errors = validate(cfg, read_secret())
    connected = clients()
    print(f"Service : {'active' if active else state}  ({'enabled' if enabled else 'disabled'} at login)")
    port = net.get('port', 5900)
    bind_text = ", ".join(f"{address}:{port}" for address in listen) or "(none)"
    print(f"Bind    : {net.get('bindMode', 'auto')} -> {bind_text}")
    print(f"Auth    : {_auth_summary(cfg)}")
    print(f"Capture : {cap.get('mode', 'all')}"
          f"  fps={enc.get('maxFps', 30)}"
          f"  cursor={'on' if enc.get('renderCursor') else 'off'}"
          f"  input={'on' if inp.get('enabled', True) else 'view-only'}")
    print(f"Clients : {len(connected)} connected")
    if errors:
        print("Problems: " + "; ".join(errors))


def _print_addresses(cfg: dict) -> None:
    print("Detected addresses:")
    for entry in detected_addresses():
        print(f"  - {entry['kind']:<9} {entry['address']:<16} ({entry['interface']})")
    print("Listening on (after apply):")
    for address in listen_addresses(cfg):
        print(f"  - {address}:{cfg.get('network', {}).get('port', 5900)}")
    port = cfg.get("network", {}).get("port", 5900)
    print(f"Firewall helper: sudo ~/.local/bin/end4pc-vnc-firewall {port}")
    print("Manual UFW rules:")
    interfaces = sorted({entry["interface"] for entry in detected_addresses() if entry["kind"] in {"lan", "tailscale"}})
    for interface in interfaces:
        print(f"  ufw allow in on {interface} to any port {port} proto tcp")


def _print_config(cfg: dict) -> None:
    print(json.dumps(cfg, indent=2, sort_keys=True))


def _service_menu(cfg: dict) -> bool:
    dirty = False
    while True:
        _menu_clear()
        active, enabled, state = service_state()
        print("Service")
        print("=======")
        print(f"State: {state}; autostart: {'on' if enabled else 'off'}")
        if dirty:
            print("There are unapplied changes; apply them before starting if they matter.")
        print("1) Start")
        print("2) Stop")
        print("3) Restart")
        print(f"4) Autostart at login: {'on' if cfg.get('autostart') else 'off'}")
        print("5) Show service status")
        print("0) Back")
        choice = _menu_input("Select")
        if choice == "0":
            return dirty
        if choice == "1":
            ok, err = systemctl("start")
            print("Started." if ok else f"Failed: {err}")
            _menu_pause()
        elif choice == "2":
            ok, err = systemctl("stop")
            print("Stopped." if ok else f"Failed: {err}")
            _menu_pause()
        elif choice == "3":
            ok, err = systemctl("restart")
            print("Restarted." if ok else f"Failed: {err}")
            _menu_pause()
        elif choice == "4":
            cfg["autostart"] = not bool(cfg.get("autostart"))
            dirty = True
        elif choice == "5":
            rc, out, err = run(["systemctl", "--user", "status", SERVICE, "--no-pager"], timeout=10)
            print(out or err)
            _menu_pause()


def _network_menu(cfg: dict) -> bool:
    dirty = False
    net = cfg.setdefault("network", {})
    while True:
        _menu_clear()
        print("Network & access")
        print("=================")
        print(f"1) Bind mode: {net.get('bindMode', 'auto')}  (auto = localhost + LAN/Wi-Fi + Tailscale)")
        print(f"2) Custom address: {net.get('address', '')}")
        print(f"3) Port: {net.get('port', 5900)}")
        print(f"4) TLS authentication: {'on' if net.get('auth') else 'off'}")
        print(f"5) PAM authentication: {'on' if net.get('pam') else 'off'}")
        print(f"6) Username: {net.get('username', '')}")
        print("7) Set VNC password")
        print("8) Regenerate TLS certificate")
        print("9) Show detected addresses and firewall commands")
        print("f) Apply firewall rules for this port (sudo)")
        print("0) Back")
        choice = _menu_input("Select")
        if choice == "0":
            return dirty
        if choice == "1":
            net["bindMode"] = "custom" if net.get("bindMode", "auto") == "auto" else "auto"
            if net["bindMode"] == "auto" and not net.get("auth"):
                print("Automatic mode exposes LAN/Tailscale addresses and requires authentication.")
            dirty = True
        elif choice == "2":
            value = _menu_input("Custom bind address", str(net.get("address", "127.0.0.1")))
            net["address"] = value
            if net.get("bindMode", "auto") != "custom":
                net["bindMode"] = "custom"
                print("Switched to custom bind mode.")
            dirty = True
        elif choice == "3":
            net["port"] = _menu_int("Port", int(net.get("port", 5900)), 1024, 65535)
            dirty = True
        elif choice == "4":
            net["auth"] = _menu_bool("TLS authentication", bool(net.get("auth")))
            dirty = True
        elif choice == "5":
            net["pam"] = _menu_bool("PAM authentication (system password)", bool(net.get("pam")))
            dirty = True
        elif choice == "6":
            net["username"] = _menu_input("VNC username", str(net.get("username", "")))
            dirty = True
        elif choice == "7":
            first = getpass.getpass("New VNC password: ")
            second = getpass.getpass("Repeat password: ")
            if not first or first != second:
                print("Passwords are empty or do not match.")
            elif first != first.strip() or "\n" in first or "\r" in first:
                print("The password cannot contain newlines or surrounding whitespace.")
            else:
                write_secret(first)
                print("Password saved. It takes effect after Apply/restart when PAM is off.")
                dirty = True
        elif choice == "8":
            if not net.get("auth"):
                print("TLS authentication is off; certificate is not used.")
            for path in (CERT_FILE, KEY_FILE):
                if path.exists():
                    try:
                        os.replace(path, path.with_suffix(path.suffix + ".bak"))
                    except OSError:
                        pass
            try:
                ensure_tls(cfg)
                print("Certificate regenerated.")
                print(f"SHA256: {fingerprint()}")
            except RuntimeError as exc:
                print(f"Failed: {exc}")
            _menu_pause()
        elif choice == "9":
            _print_addresses(cfg)
            _menu_pause()
        elif choice.lower() == "f":
            helper = shutil.which("end4pc-vnc-firewall") or str(HOME / ".local/bin/end4pc-vnc-firewall")
            if not Path(helper).exists():
                print("Firewall helper not found. Install optional/vnc/firewall.sh first.")
            else:
                try:
                    rc = subprocess.run(["sudo", helper, str(net.get("port", 5900))]).returncode
                    print("Firewall rules applied." if rc == 0 else f"Firewall helper exited with {rc}.")
                except OSError as exc:
                    print(f"Cannot run sudo: {exc}")
            _menu_pause()


def _display_menu(cfg: dict) -> bool:
    dirty = False
    cap = cfg.setdefault("capture", {})
    enc = cfg.setdefault("encoding", {})
    while True:
        _menu_clear()
        outputs = physical_outputs()
        print("Capture & encoding")
        print("==================")
        print(f"1) Capture mode: {cap.get('mode', 'all')}")
        print(f"2) Output: {cap.get('output', '')}")
        print(f"3) Maximum FPS: {enc.get('maxFps', 30)}")
        print(f"4) Render cursor: {'on' if enc.get('renderCursor') else 'off'}")
        print(f"5) GPU acceleration: {'on' if enc.get('gpu') else 'off'}")
        print(f"6) Disable client resizing: {'on' if enc.get('disableResizing') else 'off'}")
        print("0) Back")
        choice = _menu_input("Select")
        if choice == "0":
            return dirty
        if choice == "1":
            cap["mode"] = "single" if cap.get("mode", "all") == "all" else "all"
            print(f"Capture mode: {cap['mode']}")
            dirty = True
        elif choice == "2":
            if not outputs:
                print("No physical outputs were detected.")
                _menu_pause()
                continue
            for index, output in enumerate(outputs, 1):
                print(f"  {index}) {output.get('name')}  {output.get('width')}x{output.get('height')}")
            raw = _menu_input("Output number", "1")
            try:
                chosen = outputs[int(raw) - 1]
                cap["output"] = str(chosen.get("name"))
                cap["mode"] = "single"
                dirty = True
            except (ValueError, IndexError):
                print("Invalid output.")
                _menu_pause()
        elif choice == "3":
            enc["maxFps"] = _menu_int("Maximum FPS", int(enc.get("maxFps", 30)), 1, 120)
            dirty = True
        elif choice == "4":
            enc["renderCursor"] = _menu_bool("Render cursor", bool(enc.get("renderCursor")))
            dirty = True
        elif choice == "5":
            enc["gpu"] = _menu_bool("GPU acceleration", bool(enc.get("gpu")))
            dirty = True
        elif choice == "6":
            enc["disableResizing"] = _menu_bool("Disable client resizing", bool(enc.get("disableResizing")))
            dirty = True


def _input_menu(cfg: dict) -> bool:
    dirty = False
    inp = cfg.setdefault("input", {})
    xkb = inp.setdefault("xkb", {})
    while True:
        _menu_clear()
        print("Input & keyboard")
        print("================")
        print(f"1) Allow remote input: {'on' if inp.get('enabled', True) else 'view-only'}")
        print(f"2) Match host keyboard: {'on' if inp.get('matchHostKeyboard', True) else 'off'}")
        if not inp.get("matchHostKeyboard", True):
            print(f"3) XKB layout: {xkb.get('layout', '')}")
            print(f"4) XKB options: {xkb.get('options', '')}")
            print(f"5) XKB variant: {xkb.get('variant', '')}")
            print(f"6) XKB model: {xkb.get('model', '')}")
            print(f"7) XKB rules: {xkb.get('rules', '')}")
        print(f"8) Seat: {inp.get('seat', '') or 'default'}")
        print("0) Back")
        choice = _menu_input("Select")
        if choice == "0":
            return dirty
        if choice == "1":
            inp["enabled"] = _menu_bool("Allow remote input", bool(inp.get("enabled", True)))
            dirty = True
        elif choice == "2":
            inp["matchHostKeyboard"] = _menu_bool("Match host keyboard", bool(inp.get("matchHostKeyboard", True)))
            dirty = True
        elif choice == "3":
            xkb["layout"] = _menu_input("XKB layout", str(xkb.get("layout", "")))
            dirty = True
        elif choice == "4":
            xkb["options"] = _menu_input("XKB options", str(xkb.get("options", "")))
            dirty = True
        elif choice == "5":
            xkb["variant"] = _menu_input("XKB variant", str(xkb.get("variant", "")))
            dirty = True
        elif choice == "6":
            xkb["model"] = _menu_input("XKB model", str(xkb.get("model", "")))
            dirty = True
        elif choice == "7":
            xkb["rules"] = _menu_input("XKB rules", str(xkb.get("rules", "")))
            dirty = True
        elif choice == "8":
            inp["seat"] = _menu_input("Seat (empty = default)", str(inp.get("seat", "")))
            dirty = True


def _behavior_menu(cfg: dict) -> bool:
    dirty = False
    beh = cfg.setdefault("behavior", {})
    levels = ["error", "warning", "info", "debug", "trace", "quiet"]
    while True:
        _menu_clear()
        print("Behaviour")
        print("=========")
        print(f"1) Lock session when the last client disconnects: {'on' if beh.get('lockOnDisconnect') else 'off'}")
        print(f"2) Inhibit idle while connected: {'on' if beh.get('inhibitIdle') else 'off'}")
        print(f"3) Stop VNC when the last client disconnects: {'on' if beh.get('exitOnDisconnect') else 'off'}")
        print(f"4) Log level: {beh.get('logLevel', 'warning')}")
        print("0) Back")
        choice = _menu_input("Select")
        if choice == "0":
            return dirty
        if choice == "1":
            beh["lockOnDisconnect"] = _menu_bool("Lock on disconnect", bool(beh.get("lockOnDisconnect")))
            dirty = True
        elif choice == "2":
            beh["inhibitIdle"] = _menu_bool("Inhibit idle while connected", bool(beh.get("inhibitIdle")))
            dirty = True
        elif choice == "3":
            beh["exitOnDisconnect"] = _menu_bool("Stop VNC on last disconnect", bool(beh.get("exitOnDisconnect")))
            dirty = True
        elif choice == "4":
            for index, level in enumerate(levels, 1):
                print(f"  {index}) {level}")
            raw = _menu_input("Log level number", str(levels.index(beh.get("logLevel", "warning")) + 1))
            try:
                beh["logLevel"] = levels[int(raw) - 1]
                dirty = True
            except (ValueError, IndexError):
                print("Invalid level.")
                _menu_pause()


def _uptime_text(seconds: object) -> str:
    try:
        n = int(seconds)
    except (TypeError, ValueError):
        return "unknown"
    if n < 60:
        return f"{n}s"
    if n < 3600:
        return f"{n // 60}m"
    if n < 86400:
        return f"{n // 3600}h {(n % 3600) // 60}m"
    return f"{n // 86400}d {(n % 86400) // 3600}h"


def _clients_menu() -> None:
    while True:
        _menu_clear()
        connected = clients()
        print("Clients")
        print("=======")
        if not connected:
            print("No clients connected. Waiting for an incoming VNC connection.")
        for client in connected:
            print()
            print(f"  {client.get('username') or '(unnamed)'}  <{client.get('id')}>")
            print(f"    address   : {client.get('address') or 'unknown'}")
            print(f"    via       : {client.get('kind') or 'unknown'}"
                  f"{' (' + client['interface'] + ')' if client.get('interface') else ''}")
            print(f"    seat      : {client.get('seat') or 'unknown'}")
            print(f"    connected : {client.get('connectedSince') or 'unknown'}"
                  f"  ({_uptime_text(client.get('uptimeSeconds'))})")
        print()
        print("d) Disconnect a client")
        print("a) Disconnect all clients")
        print("r) Refresh")
        print("0) Back")
        choice = _menu_input("Select")
        if choice == "0":
            return
        if choice == "d":
            client_id = _menu_input("Client id", str(connected[0].get("id") or "") if connected else "")
            if client_id:
                rc, out, err = wayvncctl(["client-disconnect", client_id])
                print("Disconnected." if rc == 0 else f"Failed: {(err or out).strip()}")
                _menu_pause()
        elif choice == "a":
            if not connected:
                print("Nobody is connected.")
            elif _menu_confirm(f"Disconnect all {len(connected)} client(s)?", False):
                result = cmd_disconnect_all(argparse.Namespace())
                print("Disconnected." if result == 0 else "Some clients could not be disconnected.")
                _menu_pause()
        elif choice == "r":
            pass


def _outputs_menu() -> None:
    while True:
        _menu_clear()
        outputs = output_list()
        print("Outputs")
        print("=======")
        if not outputs:
            print("No output list available (is the service running?).")
        for index, output in enumerate(outputs, 1):
            marker = " [CURRENT]" if output.get("captured") else ""
            print(f"  {index}) {output.get('name')}  "
                  f"{output.get('width')}x{output.get('height')}"
                  f"{'  ' + str(output.get('power')) if output.get('power') else ''}{marker}")
            if output.get("description"):
                print(f"       {output['description']}")
        print()
        print("1-N) Capture that output now (live only)")
        print("r) Refresh")
        print("0) Back")
        choice = _menu_input("Select")
        if choice == "0":
            return
        if choice.isdigit() and 1 <= int(choice) <= len(outputs):
            name = outputs[int(choice) - 1].get("name")
            rc, out, err = wayvncctl(["output-set", str(name)])
            print(f"Switched to {name}." if rc == 0 else f"Failed: {(err or out).strip()}")
            _menu_pause()


def _logs_menu() -> None:
    _menu_clear()
    rc, out, err = run(["journalctl", "--user", "-u", SERVICE, "-n", "120", "--no-pager"], timeout=10)
    print(out or err or "No log output.")
    _menu_pause()


def _review_menu(cfg: dict) -> tuple[dict, dict, bool]:
    dirty = True
    while True:
        _menu_clear()
        print("Review / apply")
        print("==============")
        print("Pending configuration:")
        _print_config(cfg)
        errors = validate(cfg, read_secret())
        if errors:
            print("\nProblems:")
            for error in errors:
                print(f"  - {error}")
        print("\n1) Apply and restart VNC if it is running")
        print("2) Reload configuration from disk (discard pending changes)")
        print("3) Discard pending changes")
        print("0) Back")
        choice = _menu_input("Select")
        if choice == "0":
            return cfg, load_config(), True
        if choice == "1":
            result = apply_patch(cfg)
            if result.get("ok"):
                print("Applied.")
                if result.get("restarted"):
                    print("VNC restarted with the new configuration.")
                return load_config(), load_config(), False
            print(f"Failed: {result.get('error', 'unknown error')}")
            _menu_pause()
        elif choice == "2":
            return load_config(), load_config(), False
        elif choice == "3":
            return load_config(), load_config(), False


def cmd_menu(_args: argparse.Namespace) -> int:
    cfg = load_config()
    original = json.loads(json.dumps(cfg))
    dirty = False
    try:
        while True:
            _menu_clear()
            print(f"{APP} interactive configurator")
            print("=" * 42)
            _print_summary(cfg)
            print()
            print("1) Status, addresses and validation")
            print("2) Service start/stop/restart/autostart")
            print("3) Network & access (bind mode, port, TLS/PAM)")
            print("4) Capture & encoding")
            print("5) Input & keyboard")
            print("6) Behaviour")
            print("7) Clients")
            print("8) Outputs")
            print("9) Service log")
            print("10) Review / apply changes")
            print("0) Exit")
            if dirty:
                print("\n* unsaved changes")
            choice = _menu_input("Select")
            if choice == "0":
                if dirty:
                    if _menu_confirm("Apply changes before exit?", True):
                        result = apply_patch(cfg)
                        if not result.get("ok"):
                            print(f"Failed: {result.get('error')}")
                            _menu_pause()
                            continue
                        print("Applied.")
                return 0
            if choice == "1":
                _menu_clear()
                _print_summary(cfg)
                print()
                _print_addresses(cfg)
                print("\nActive clients:")
                for client in clients():
                    print(f"  id={client.get('id')} address={client.get('address')} user={client.get('username')}")
                errors = validate(cfg, read_secret())
                print("\nValidation: " + ("OK" if not errors else "; ".join(errors)))
                _menu_pause()
            elif choice == "2":
                dirty = _service_menu(cfg) or dirty
            elif choice == "3":
                dirty = _network_menu(cfg) or dirty
            elif choice == "4":
                dirty = _display_menu(cfg) or dirty
            elif choice == "5":
                dirty = _input_menu(cfg) or dirty
            elif choice == "6":
                dirty = _behavior_menu(cfg) or dirty
            elif choice == "7":
                _clients_menu()
            elif choice == "8":
                _outputs_menu()
            elif choice == "9":
                _logs_menu()
            elif choice == "10":
                cfg, original, dirty = _review_menu(cfg)
    except KeyboardInterrupt:
        print("\nInterrupted.")
        return 130



def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog=APP)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("menu", aliases=["configure", "tui"], help="interactive configurator (use over ssh -t)")
    p.set_defaults(func=cmd_menu)

    p = sub.add_parser("status", help="print the complete status as JSON")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("apply", help="merge a JSON patch, validate and apply it")
    p.add_argument("--stdin", action="store_true", help="read the JSON patch from stdin (default)")
    p.set_defaults(func=cmd_apply)

    p = sub.add_parser("init", help="create config, secret and TLS certificate")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("password", help="set the VNC password from stdin")
    p.add_argument("--stdin", action="store_true", help="read the password from stdin (default)")
    p.set_defaults(func=cmd_password)

    p = sub.add_parser("cert", help="manage the TLS certificate")
    p.add_argument("action", choices=["regenerate"])
    p.set_defaults(func=cmd_cert)

    p = sub.add_parser("service", help="control the user service")
    p.add_argument("action", choices=["start", "stop", "restart", "enable", "disable", "autostart-on", "autostart-off"])
    p.set_defaults(func=cmd_service)

    p = sub.add_parser("clients", help="list connected clients")
    p.set_defaults(func=cmd_clients)

    p = sub.add_parser("outputs", help="list outputs")
    p.set_defaults(func=cmd_outputs)

    p = sub.add_parser("output-set", help="switch the captured output live")
    p.add_argument("name")
    p.set_defaults(func=cmd_output_set)

    p = sub.add_parser("desktop-name", help="set the desktop name live")
    p.add_argument("name")
    p.set_defaults(func=cmd_desktop_name)

    p = sub.add_parser("disconnect", help="disconnect one client")
    p.add_argument("id")
    p.set_defaults(func=cmd_disconnect)

    p = sub.add_parser("disconnect-all", help="disconnect every connected client")
    p.set_defaults(func=cmd_disconnect_all)

    p = sub.add_parser("log", help="show the user service log")
    p.add_argument("-n", "--lines", type=int, default=200)
    p.set_defaults(func=cmd_log)

    p = sub.add_parser("validate", help="validate the current config")
    p.set_defaults(func=cmd_validate)

    p = sub.add_parser("run", help="run wayvnc (systemd entry point)")
    p.set_defaults(func=cmd_run)

    args = parser.parse_args(argv)
    try:
        return int(args.func(args) or 0)
    except KeyboardInterrupt:
        return 130
    except Exception as exc:  # keep the QML side informed
        print(json.dumps({"ok": False, "error": str(exc)}))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
