[Unit]
Description=WayVNC remote desktop for the active Hyprland session
Documentation=man:wayvnc(1)
# Start only once the graphical session (and thus WAYLAND_DISPLAY) exists.
# Waiting on network-online.target instead caused the service to start before
# the compositor was ready, and default.target made it outlive the session.
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/end4pc-vnc run
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
