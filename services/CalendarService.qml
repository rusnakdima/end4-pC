pragma Singleton
pragma ComponentBehavior: Bound

import qs.modules.common
import Quickshell
import Quickshell.Io
import QtQuick

/**
 * File backed calendar for the cheatsheet's Timetable tab.
 *
 * The data lives in a single JSON file, keyed by ISO date:
 *   {
 *     "2026-10-23": [
 *       { "title": "Standup", "description": "Room 2", "start": "09:30", "end": "09:45" }
 *     ]
 *   }
 *
 * A missing file is a valid "no events" state, not an error.
 */
Singleton {
    id: root

    property string filePath: Directories.calendarPath

    // 7 entries, one per day of the current week. Index 0 is the configured
    // first day of the week (0 = Monday, 6 = Sunday).
    // The eventsInWeekChanged signal is generated by the property itself,
    // so it must not be declared again: a duplicate signal name stops the
    // whole config from loading.
    readonly property var eventsInWeek: _weekDays

    property var _weekDays: []

    function _dateKey(date) {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, "0");
        const d = String(date.getDate()).padStart(2, "0");
        return `${y}-${m}-${d}`;
    }

    function _firstDayOfWeek() {
        // The cheatsheet formula only supports Monday (0) and Sunday (6);
        // any other value produces a negative JS modulo.
        const configured = Config.options?.time?.firstDayOfWeek ?? 0;
        return configured === 6 ? 6 : 0;
    }

    function _emptyWeek() {
        const days = [];
        for (let i = 0; i < 7; i++) {
            days.push({ "name": "", "date": "", "events": [] });
        }
        return days;
    }

    function rebuild() {
        const clockDate = DateTime.clock?.date;
        if (!clockDate) {
            if (root._weekDays.length !== 0)
                root._weekDays = root._emptyWeek();
            return;
        }

        const first = root._firstDayOfWeek();
        // getDay(): 0 = Sunday ... 6 = Saturday
        const startDow = first === 6 ? 0 : 1;
        const todayDow = clockDate.getDay();
        const offset = (todayDow - startDow + 7) % 7;
        const monday = new Date(clockDate.getFullYear(), clockDate.getMonth(), clockDate.getDate() - offset);

        const data = root._parsed ?? {};
        const days = [];
        for (let i = 0; i < 7; i++) {
            const date = new Date(monday.getFullYear(), monday.getMonth(), monday.getDate() + i);
            const key = root._dateKey(date);
            const events = Array.isArray(data[key]) ? data[key] : [];
            days.push({
                "name": Qt.locale().toString(date, "ddd"),
                "date": key,
                "events": events
            });
        }

        root._weekDays = days;
        root.eventsInWeekChanged();
    }

    property var _parsed: null

    Component.onCompleted: {
        root.rebuild();
    }

    Connections {
        target: DateTime.clock
        function onDateChanged() {
            root.rebuild();
        }
    }

    FileView {
        id: calendarFile
        path: root.filePath
        watchChanges: true
        onLoaded: {
            try {
                root._parsed = JSON.parse(calendarFile.text());
            } catch (e) {
                console.warn("[CalendarService] Malformed calendar file, showing an empty week: " + e);
                root._parsed = null;
            }
            root.rebuild();
        }
        onLoadFailed: {
            root._parsed = null;
            root.rebuild();
        }
    }
}
