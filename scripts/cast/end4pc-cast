# discovery internals
# ---------------------------------------------------------------------------

def parse_waycast_sinks(text: str) -> list[dict]:
    """Parse waycast's ASCII table: rows look like `| Name | AA:BB:... |`."""
    sinks: list[dict] = []
    for line in (text or "").splitlines():
        tokens = [part.strip() for part in line.split() if part.strip() != "|"]
        for index, token in enumerate(tokens):
            if MAC_RE.match(token) and index > 0:
                name = " ".join(tokens[:index]).strip()
                if name and name.lower() not in {"name", "sinks", "address"}:
                    sinks.append(normalize_sink(name, token, "wfd"))
                break
    return dedupe_sinks(sinks)


def discover_local() -> tuple[list[dict], str]:
    binary = find_backend("waycast")
    if not binary:
        return [], "waycast is not installed; local Wi-Fi Direct discovery unavailable"
    rc, out, err = run([binary, "discover", "--timeout", "10"], timeout=15)
    if rc != 0:
        return [], f"waycast discover failed: {first_line(err or out, 200) or 'unknown error'}"
    sinks = parse_waycast_sinks(out)
    if not sinks:
        sinks = parse_sinks(out, "wfd")
    return sinks, "" if sinks else "no Wi-Fi Direct sinks found"


def discover_remote() -> tuple[list[dict], str]:
    sinks: list[dict] = []
    notes: list[str] = []
    avahi = shutil.which("avahi-browse")
    if avahi:
        # -a means "all types" and conflicts with an explicit service type;
        # -rt resolves records and terminates after the first batch.
        dlna_out = ""
        cast_out = ""
        for service in ("_dlna._tcp",):
            rc, out, _err = run([avahi, "-rtp", service], timeout=8)
            if rc == 0:
                dlna_out += out + "\n"
        for service in ("_googlecast._tcp", "_airplay._tcp", "_androidtvremote2._tcp"):
            rc, out, _err = run([avahi, "-rtp", service], timeout=8)
            if rc == 0:
                cast_out += out + "\n"
        sinks.extend(parse_sinks(dlna_out, "dlna"))
        sinks.extend(parse_sinks(cast_out, "cast"))
        if not sinks:
            notes.append("avahi-browse found no DLNA/Cast services")
    else:
        notes.append("avahi-browse not found; install avahi-utils for LAN discovery")

    # fluxcast 0.3.x has no `discover` subcommand; Avahi is the discovery
    # source for both DLNA and Google Cast. Keep a note when it is absent so
    # the pane can explain why casting itself will not start.
    if not find_backend("fluxcast"):
        notes.append("fluxcast is not installed; remote Cast discovery is limited")
    return dedupe_sinks(sinks), "; ".join(notes)


# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------

def cmd_status(_args: argparse.Namespace) -> int:
    emit(status_payload())
    return 0


def cmd_apply(args: argparse.Namespace) -> int:
    raw = args.patch or ""
    if args.stdin or not raw:
        if sys.stdin.isatty():
            emit(status_payload(error="no JSON patch supplied (pass it as an argument or on stdin)", ok=False))
            return 0
        raw = sys.stdin.read()
    raw = raw.strip()
    if not raw:
        emit(status_payload(error="empty JSON patch", ok=False))
        return 0
    try:
        patch = json.loads(raw)
    except ValueError as exc:
        emit(status_payload(error=f"invalid JSON: {exc}", ok=False))
        return 0
    if not isinstance(patch, dict):
        emit(status_payload(error="JSON patch must be an object", ok=False))
        return 0
    try:
        cfg = normalize_config(deep_merge(load_config(), patch))
        atomic_write_json(CONFIG_FILE, cfg)
    except OSError as exc:
        emit(status_payload(error=f"cannot persist config: {exc}", ok=False))
        return 0
    emit(status_payload())
    return 0


def cmd_discover(args: argparse.Namespace) -> int:
    mode = getattr(args, "mode_pos", "") or args.network_mode or load_config().get("networkMode", "local")
    if mode == "local":
        sinks, note = discover_local()
    else:
        sinks, note = discover_remote()
    try:
        atomic_write_json(SINKS_FILE, sinks)
    except OSError as exc:
        note = f"{note}; cannot cache sinks: {exc}".strip("; ")
    emit(status_payload(error=note))
    return 0


def cmd_start(_args: argparse.Namespace) -> int:
    ok, note = start_session()
    emit(status_payload(error=note, ok=ok))
    return 0


def cmd_stop(_args: argparse.Namespace) -> int:
    note = stop_session()
    emit(status_payload(error=note))
    return 0


def cmd_restart(_args: argparse.Namespace) -> int:
    note = stop_session()
    ok, start_note = start_session()
    parts = [p for p in (note, start_note) if p]
    emit(status_payload(error="; ".join(parts), ok=ok))
    return 0


def cmd_log(args: argparse.Namespace) -> int:
    requested = getattr(args, "lines_pos", "") or args.lines
    try:
        n = max(1, min(int(requested), 10000))
    except (TypeError, ValueError):
        n = 200
    text = read_log_tail(n)
    emit({"ok": True, "error": "" if text else "no cast log yet", "text": text})
    return 0


# ---------------------------------------------------------------------------
# argument parsing (always JSON, even on usage errors)
# ---------------------------------------------------------------------------

class JsonCLIError(Exception):
    """Raised instead of argparse's SystemExit(2) so we can emit JSON."""


class JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:  # pragma: no cover - defensive
        raise JsonCLIError(message)


def build_parser() -> JsonArgumentParser:
    parser = JsonArgumentParser(prog=APP, description="Manage the end4-pC Cast session (JSON CLI).")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status", help="print the full status JSON (fast, read-only)").set_defaults(func=cmd_status)

    p = sub.add_parser("apply", help="merge a JSON patch into the config and print status")
    p.add_argument("patch", nargs="?", default="", help="JSON object patch (or read from stdin)")
    p.add_argument("--stdin", action="store_true", help="read the patch from stdin")
    p.set_defaults(func=cmd_apply)

    p = sub.add_parser("discover", help="discover TVs and cache the sink list")
    p.add_argument("mode_pos", nargs="?", default="", help="local or remote (same as --network-mode)")
    p.add_argument("--network-mode", choices=["local", "remote"], default=None)
    p.set_defaults(func=cmd_discover)

    sub.add_parser("start", help="start the selected backend").set_defaults(func=cmd_start)
    sub.add_parser("stop", help="stop the tracked backend").set_defaults(func=cmd_stop)
    sub.add_parser("restart", help="stop then start the backend").set_defaults(func=cmd_restart)

    p = sub.add_parser("log", help="print the last N lines of cast.log as JSON")
    p.add_argument("lines_pos", nargs="?", default="", help="number of lines (same as -n)")
    p.add_argument("-n", "--lines", type=int, default=200)
    p.set_defaults(func=cmd_log)

    return parser


def main(argv: list[str]) -> int:
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
        return int(args.func(args) or 0)
    except JsonCLIError as exc:
        emit(status_payload(error=f"argument error: {exc}", ok=False))
        return 0
    except SystemExit as exc:  # e.g. --help (0) already printed help to stdout
        return int(exc.code or 0)
    except KeyboardInterrupt:
        emit(status_payload(error="interrupted", ok=False))
        return 0
    except Exception as exc:  # last resort: never leak a traceback to stdout
        emit(status_payload(error=f"internal error: {exc}", ok=False))
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
