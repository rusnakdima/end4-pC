#!/usr/bin/env python3
"""end4pc-cast - user-level controller for the end4-pC "Cast / Remote TV" feature.

The helper is the single writer of the Cast configuration and is the only
process that launches/stops the casting backend.  The QML service calls it and
parses stdout as one JSON object, so *every* code path - including errors and
missing backends - must produce valid JSON and never a traceback on stdout.

Backends:
  * waycast  - local Miracast / Wi-Fi Direct (``waycast daemon ...``)
  * fluxcast - remote LAN / Tailscale DLNA or Google Cast

The backend is selected from ``config.networkMode`` (local -> waycast,
remote -> fluxcast).  All state lives under ~/.config/end4-pC/cast.

Only the Python standard library is used.  `status` is fast and side-effect
free; it must work even when neither backend nor any of the optional tools are
installed (the doctor array then reports ok:false with actionable details).
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timezone
from pathlib import Path

APP = "end4pc-cast"
HELPER_VERSION = 2

# ---------------------------------------------------------------------------
# paths (XDG aware, with sane fallbacks)
# ---------------------------------------------------------------------------

HOME = Path(os.environ.get("HOME") or Path.home())
XDG_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or (HOME / ".config"))
XDG_DATA_HOME = Path(os.environ.get("XDG_DATA_HOME") or (HOME / ".local" / "share"))
CAST_DIR = XDG_CONFIG_HOME / "end4-pC" / "cast"
CONFIG_FILE = CAST_DIR / "config.json"
SESSION_FILE = CAST_DIR / "session.json"
SINKS_FILE = CAST_DIR / "sinks.json"
LOG_FILE = CAST_DIR / "cast.log"
WAYCAST_BUILD_DIR = XDG_DATA_HOME / "end4pc-cast" / "waycast"
FLUXCAST_BUILD_DIR = XDG_DATA_HOME / "end4pc-cast" / "fluxcast"
# Distros (notably Arch) install portal binaries in /usr/lib, not on PATH.
PORTAL_PATHS = (
    "/usr/lib/xdg-desktop-portal",
    "/usr/lib/xdg-desktop-portal-hyprland",
)

# The exact six public config fields of the JSON contract.  Extra keys may be
# passed in an apply patch (e.g. "sink", "protocol") and are persisted, but
# they are filtered out of the status payload so the contract stays strict.
DEFAULTS = {
    "networkMode": "local",   # local (Miracast/Wi-Fi Direct) | remote (LAN/Tailscale)
    "mode": "mirror",         # mirror | extend
    "codec": "auto",          # auto | h264 | h264-sw
    "audio": True,
    "target": "",             # manual TV address for remote mode
    "interface": "",          # optional Wi-Fi interface
    "outputRes": "1280x720",  # lighter default avoids TV-side HLS buffer errors
    "fps": 20,
    "bitrate": "2M",
}
CONFIG_KEYS = tuple(DEFAULTS)

VALID = {
    "networkMode": {"local", "remote"},
    "mode": {"mirror", "extend"},
    "codec": {"auto", "h264", "h264-sw"},
    "outputRes": {"1280x720", "1920x1080", "960x540", "native"},
}

RESOLUTION_MAP = {
    "native": "",
    "960x540": "960x540",
    "1280x720": "1280x720",
    "1920x1080": "1920x1080",
}

IP_RE = re.compile(r"^(?:\d{1,3}\.){3}\d{1,3}$|^[0-9a-fA-F:]{2,}:[0-9a-fA-F:]+$")
MAC_RE = re.compile(r"^(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$")


# ---------------------------------------------------------------------------
# small helpers
# ---------------------------------------------------------------------------

def deep_merge(base: dict, patch: dict) -> dict:
    """Recursively merge ``patch`` into a copy of ``base``."""
    out = dict(base)
    for key, value in (patch or {}).items():
        if isinstance(value, dict) and isinstance(out.get(key), dict):
            out[key] = deep_merge(out[key], value)
        else:
            out[key] = value
    return out


def atomic_write_json(path: Path, obj: object, mode: int = 0o600) -> None:
    """Write JSON via tempfile + os.replace so readers never see a partial file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(obj, fh, indent=2, sort_keys=True)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            try:
                os.unlink(tmp)
            except OSError:
                pass


def read_json(path: Path, default: object) -> object:
    """Read a JSON file, returning ``default`` on any error."""
    try:
        return json.loads(path.read_text(encoding="utf-8") or "null")
    except (OSError, ValueError):
        return default


def normalize_config(cfg: dict) -> dict:
    """Coerce the six public fields to the values allowed by the contract.

    Unknown/extra keys are preserved so callers may store hints such as
    ``sink`` or ``protocol``; only the public fields are sanitised here.
    """
    out = dict(cfg or {})
    # The Settings pane stages stream settings under `stream`; flatten them
    # into the flat public config so both UI and CLI drive the same fields.
    stream = out.pop("stream", None)
    if isinstance(stream, dict):
        for key, value in stream.items():
            if key in {"mode", "codec", "audio"}:
                out[key] = value
    for key, default in DEFAULTS.items():
        value = out.get(key, default)
        if key in VALID and value not in VALID[key]:
            value = default
        if key == "audio":
            value = bool(value) if isinstance(value, bool) else str(value).lower() in {"1", "true", "yes", "on"}
        if key == "fps":
            try:
                value = max(10, min(60, int(value)))
            except (TypeError, ValueError):
                value = DEFAULTS["fps"]
        if key in {"target", "interface", "codec", "mode", "networkMode", "bitrate"}:
            value = str(value or "")
        out[key] = value
    return out


def load_config() -> dict:
    raw = read_json(CONFIG_FILE, {})
    return normalize_config(deep_merge(DEFAULTS, raw if isinstance(raw, dict) else {}))


def public_config(cfg: dict) -> dict:
    """Return the six contract fields plus the selected sink (the UI stages it)."""
    out = {key: cfg.get(key, DEFAULTS[key]) for key in CONFIG_KEYS}
    out["sink"] = str(cfg.get("sink", "") or "")
    return out


def run(cmd: list[str], timeout: float = 5.0) -> tuple[int, str, str]:
    """Run a command defensively; never raise for missing tools/timeouts."""
    try:
        proc = subprocess.run(
            cmd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            env=os.environ.copy(),
        )
        return proc.returncode, proc.stdout or "", proc.stderr or ""
    except FileNotFoundError:
        return 127, "", f"{cmd[0]}: not found"
    except subprocess.TimeoutExpired:
        return 124, "", f"{cmd[0]}: timed out"
    except OSError as exc:
        return 126, "", str(exc)


def first_line(text: str, limit: int = 160) -> str:
    for line in (text or "").splitlines():
        if line.strip():
            return line.strip()[:limit]
    return ""


# ---------------------------------------------------------------------------
# backend discovery / versions
# ---------------------------------------------------------------------------

def find_portal_binary() -> str:
    """Return an xdg-desktop-portal binary, including distros using /usr/lib."""
    for name in ("xdg-desktop-portal", "xdg-desktop-portal-hyprland"):
        path = shutil.which(name)
        if path:
            return path
    for path in PORTAL_PATHS:
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    return ""


def find_backend(name: str) -> str:
    """Return an executable path for a backend, or "" when not installed."""
    path = shutil.which(name)
    if path:
        return path
    build_dir = WAYCAST_BUILD_DIR if name == "waycast" else FLUXCAST_BUILD_DIR
    candidates = [
        build_dir / "target" / "release" / name,
        build_dir / "bin" / name,
        build_dir / name,
    ]
    for candidate in candidates:
        if candidate.is_file() and os.access(str(candidate), os.X_OK):
            return str(candidate)
    return ""


def backend_info(name: str) -> dict:
    """Report {"installed": bool, "version": str} for a backend."""
    path = find_backend(name)
    if not path:
        return {"installed": False, "version": ""}
    rc, out, _err = run([path, "--version"], timeout=3)
    # Some backends (waycast) have no --version flag; never show the usage
    # error text as a version string.
    version = first_line(out) if rc == 0 else ""
    return {"installed": True, "version": version}


def select_backend(cfg: dict) -> str:
    """Derive the backend from the network mode (the only documented selector)."""
    return "waycast" if cfg.get("networkMode") == "local" else "fluxcast"


def supported_flags(binary: str) -> set[str]:
    """Collect --flags/-f tokens from a backend's --help output."""
    if not binary:
        return set()
    _rc, out, err = run([binary, "--help"], timeout=4)
    text = f"{out}\n{err}"
    return set(re.findall(r"(?<![\w-])(--?[A-Za-z][A-Za-z0-9-]*)", text))


# ---------------------------------------------------------------------------
# session tracking
# ---------------------------------------------------------------------------

def inactive_session(mode: str = "mirror") -> dict:
    return {
        "active": False,
        "backend": "",
        "sink": "",
        "mode": mode if mode in VALID["mode"] else "mirror",
        "startedAt": "",
        "pid": 0,
    }


def load_session() -> dict:
    raw = read_json(SESSION_FILE, {})
    base = inactive_session()
    if isinstance(raw, dict):
        base.update(raw)
    return base


def process_alive(pid: int, backend: str = "") -> bool:
    """Check liveness, verifying /proc cmdline when available."""
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except (ProcessLookupError, PermissionError, OSError):
        return False
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", "ignore")
        if cmdline:  # a live process; zombies have an empty cmdline
            if backend and backend not in cmdline:
                return False
            return True
        return False
    except OSError:
        return True  # /proc unavailable: trust os.kill(pid, 0)


# ---------------------------------------------------------------------------
# log + sink cache
# ---------------------------------------------------------------------------

def read_log_tail(n: int = 8) -> str:
    try:
        lines = LOG_FILE.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return ""
    if n <= 0:
        return ""
    return "\n".join(lines[-n:])


def load_sinks() -> list[dict]:
    raw = read_json(SINKS_FILE, [])
    if not isinstance(raw, list):
        return []
    out = []
    for item in raw:
        if isinstance(item, dict):
            out.append({
                "name": str(item.get("name") or "").strip(),
                "address": str(item.get("address") or "").strip(),
                "type": item.get("type") if item.get("type") in {"wfd", "dlna", "cast"} else "wfd",
            })
    return out


def dedupe_sinks(sinks: list[dict]) -> list[dict]:
    seen = set()
    out = []
    for sink in sinks:
        key = (sink.get("name", ""), sink.get("address", ""))
        if key in seen:
            continue
        seen.add(key)
        out.append(sink)
    return out


def normalize_sink(name: object, address: object, type_: object) -> dict:
    kind = str(type_ or "").lower()
    if "cast" in kind:
        kind = "cast"
    elif "dlna" in kind:
        kind = "dlna"
    else:
        kind = "wfd"
    return {
        "name": str(name or "").strip(),
        "address": str(address or "").strip(),
        "type": kind,
    }


def parse_sinks(text: str, default_type: str = "wfd") -> list[dict]:
    """Parse backend/Avahi discovery output defensively.

    Accepts a JSON array, a JSON object with sinks/results/devices, or plain
    text lines (Avahi's ``+;iface;IPv4;Name;_svc._tcp;local;host;ip;port`` and
    simple ``Name address``/``Name | address`` forms).
    """
    text = (text or "").strip()
    if not text:
        return []
    sinks: list[dict] = []

    try:
        data = json.loads(text)
        if isinstance(data, dict):
            for key in ("sinks", "results", "devices", "targets"):
                if isinstance(data.get(key), list):
                    data = data[key]
                    break
        if isinstance(data, list):
            for item in data:
                if not isinstance(item, dict):
                    continue
                name = item.get("name") or item.get("friendlyName") or item.get("device") or ""
                addr = item.get("address") or item.get("ip") or item.get("host") or ""
                typ = item.get("type") or item.get("protocol") or default_type
                sinks.append(normalize_sink(name, addr, typ))
            if sinks:
                return dedupe_sinks(sinks)
    except ValueError:
        pass  # fall through to line parsing

    for line in text.splitlines():
        line = line.strip()
        if line[:1] in {"+", "-", "="}:
            line = line[1:].lstrip("; ")
        line = line.strip()
        if not line:
            continue
        parts = [p.strip() for p in re.split(r"[|;\t]", line) if p.strip()]
        if not parts:
            continue
        # avahi-browse -rtp: eth0;IPv4;Name;_svc._tcp;local;host;ip;port;txt
        service_index = next((i for i, part in enumerate(parts) if "_tcp" in part.lower()), -1)
        if service_index >= 2:
            service = parts[service_index].lower()
            typ = "cast" if "googlecast" in service or "cast" in service else "dlna"
            name = parts[service_index - 1]
            address = next((p for p in parts[service_index + 1:] if IP_RE.match(p)), "")
            # The TXT record carries `fn=` (friendly name), much nicer in the
            # pane than the service instance ID.
            for extra in parts[service_index + 1:]:
                match = re.search(r'\bfn=([^\s"]+)', extra)
                if match:
                    name = match.group(1)
                    break
            # Link-local IPv6 is not a useful cast target; the same service is
            # normally also announced over IPv4.
            if not address or address.lower().startswith("fe80:"):
                continue
            sinks.append(normalize_sink(name, address, typ))
            continue
        name = parts[0]
        addr = ""
        for candidate in parts[1:]:
            if IP_RE.match(candidate) or MAC_RE.match(candidate):
                addr = candidate
                break
        if not addr and len(parts) >= 2:
            addr = parts[1]
        sinks.append(normalize_sink(name, addr, default_type))
    return dedupe_sinks(sinks)


# ---------------------------------------------------------------------------
# doctor checks (read-only, fast, actionable)
# ---------------------------------------------------------------------------

def doctor_checks() -> list[dict]:
    """Return the health checks consumed by the Settings page.

    Every check is defensive: missing tools become ok:false with a detail that
    tells the user what to install or enable.
    """
    checks: list[dict] = []

    def add(id_: str, label: str, ok: bool, detail: str) -> None:
        checks.append({"id": id_, "label": label, "ok": bool(ok), "detail": str(detail)})

    # 1. Hyprland / wlroots ---------------------------------------------------
    display = os.environ.get("WAYLAND_DISPLAY", "")
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    hyprctl = shutil.which("hyprctl")
    hypr_ok = bool(display and (signature or hyprctl))
    if hypr_ok:
        add("hyprland", "Hyprland / wlroots", True,
            f"Wayland display '{display}' detected; desktop capture should work.")
    else:
        add("hyprland", "Hyprland / wlroots", False,
            "No Wayland/Hyprland session detected. Start the helper from inside "
            "the Hyprland session (WAYLAND_DISPLAY and HYPRLAND_INSTANCE_SIGNATURE).")

    # 2. xdg-desktop-portal --------------------------------------------------
    portal = find_portal_binary()
    add("portal", "xdg-desktop-portal", bool(portal),
        f"Using '{portal}'." if portal else
        "xdg-desktop-portal not found. Install xdg-desktop-portal and "
        "xdg-desktop-portal-hyprland and re-login.")

    # 3. Wi-Fi Direct (P2P) --------------------------------------------------
    iw = shutil.which("iw")
    p2p_ok = False
    p2p_detail = "iw not found. Install 'iw' and a Wi-Fi device with P2P support."
    if iw:
        rc, dev_out, _ = run([iw, "dev"], timeout=2)
        p2p_ok = rc == 0 and ("interface p2p" in dev_out.lower() or "type p2p" in dev_out.lower())
        if not p2p_ok and rc == 0:
            rc2, list_out, _ = run([iw, "list"], timeout=3)
            p2p_ok = rc2 == 0 and "p2p" in list_out.lower()
        p2p_detail = (
            "A Wi-Fi P2P device is available (check `iw dev` / `iw list`)."
            if p2p_ok else
            "No P2P-capable Wi-Fi device found in `iw dev`/`iw list`. "
            "Start wpa_supplicant with a P2P config (see the installer) or "
            "waycast-networkd, or switch to remote (DLNA/Cast) mode."
        )
    add("p2p", "Wi-Fi Direct", p2p_ok, p2p_detail)

    # 4/5. backends ----------------------------------------------------------
    wc = backend_info("waycast")
    add("waycast", "waycast (Miracast)", wc["installed"],
        f"waycast {wc['version']}".strip() if wc["installed"] else
        "waycast not found. Install it via `optional/cast/install-user.sh "
        "--build-waycast`, your package manager, or a release binary.")

    fc = backend_info("fluxcast")
    add("fluxcast", "fluxcast (DLNA / Cast)", fc["installed"],
        f"fluxcast {fc['version']}".strip() if fc["installed"] else
        "fluxcast not found. Install it on PATH or under "
        "~/.local/share/end4pc-cast/fluxcast for remote DLNA/Cast casting.")

    # 6. encoder ------------------------------------------------------------
    ffmpeg = shutil.which("ffmpeg")
    wf = shutil.which("wf-recorder")
    add("encoder", "ffmpeg / wf-recorder", bool(ffmpeg or wf),
        f"Using '{ffmpeg or wf}'." if (ffmpeg or wf) else
        "No screen encoder found. Install 'ffmpeg' (or 'wf-recorder') for "
        "H.264 capture.")

    # 7. GStreamer H.264 -----------------------------------------------------
    gst_launch = shutil.which("gst-launch-1.0")
    gst_inspect = shutil.which("gst-inspect-1.0")
    gst_ok = False
    gst_detail = "GStreamer not found. Install gstreamer and gst-plugins-ugly (x264enc) or gst-plugin-openh264."
    if gst_launch and gst_inspect:
        for plugin in ("x264enc", "openh264enc"):
            rc, _out, _err = run([gst_inspect, plugin], timeout=2)
            if rc == 0:
                gst_ok = True
                gst_detail = f"GStreamer H.264 encoder '{plugin}' is available."
                break
        if not gst_ok:
            gst_detail = "gst-launch-1.0 is present but no H.264 encoder was found. Install gst-plugins-ugly (x264enc) or gst-plugin-openh264."
    add("gstreamer", "GStreamer H.264", gst_ok, gst_detail)

    # 8. audio --------------------------------------------------------------
    pactl = shutil.which("pactl")
    add("audio", "Audio (pactl)", bool(pactl),
        f"Using '{pactl}' for audio routing." if pactl else
        "pactl not found. Install pipewire-pulse (or pulseaudio) so cast audio "
        "can be routed; otherwise disable audio in Settings.")

    # 9. inbound RTSP port (local Miracast) ---------------------------------
    # waycast's default role has the TV connect to us on TCP 7236. A blocked
    # port produces exactly "TV says no connection" with a perfectly healthy
    # P2P link, so make it a first-class check instead of a buried README note.
    ufw = shutil.which("ufw")
    if not ufw:
        add("rtsp", "Miracast RTSP port", True,
            "No ufw found; make sure inbound TCP 7236 is allowed for local Miracast.")
    else:
        rc, out, err = run([ufw, "status"], timeout=3)
        # On non-root runs ufw writes the permission error to stderr (rc=1),
        # so inspect both streams instead of treating it as a blocked port.
        text = (out + " " + err).lower()
        if "need to be root" in text or "permission" in text:
            add("rtsp", "Miracast RTSP port", True,
                "Cannot verify ufw status as non-root; run as root or ensure "
                "inbound TCP 7236 is allowed for local Miracast.")
        elif rc == 0 and "inactive" in text:
            add("rtsp", "Miracast RTSP port", True,
                "ufw is inactive; inbound TCP 7236 is not firewalled.")
        elif rc == 0 and "7236" in out:
            add("rtsp", "Miracast RTSP port", True,
                "Inbound TCP 7236 appears allowed by ufw.")
        else:
            add("rtsp", "Miracast RTSP port", False,
                "Inbound TCP 7236 is not allowed. Run: "
                "sudo ufw allow 7236/tcp comment 'end4pc cast'")

    return checks


# ---------------------------------------------------------------------------
# status payload
# ---------------------------------------------------------------------------

def status_payload(error: str = "", ok: bool = True) -> dict:
    """Build the complete contract object. Never writes anything."""
    cfg = load_config()
    raw_session = load_session()
    pid = int(raw_session.get("pid") or 0)
    backend = str(raw_session.get("backend") or "")
    active = process_alive(pid, backend)
    if active:
        session = {
            "active": True,
            "backend": backend,
            "sink": str(raw_session.get("sink") or ""),
            "mode": raw_session.get("mode") if raw_session.get("mode") in VALID["mode"] else cfg["mode"],
            "startedAt": str(raw_session.get("startedAt") or ""),
            "pid": pid,
        }
    else:
        session = inactive_session(cfg["mode"])

    return {
        "ok": bool(ok),
        "error": str(error or ""),
        "helperVersion": HELPER_VERSION,
        "config": public_config(cfg),
        "backends": {
            "waycast": backend_info("waycast"),
            "fluxcast": backend_info("fluxcast"),
        },
        "session": session,
        "sinks": load_sinks(),
        "doctor": doctor_checks(),
        "logTail": read_log_tail(8),
    }


def emit(payload: dict) -> None:
    """Print exactly one JSON object to stdout."""
    print(json.dumps(payload, ensure_ascii=False))


# ---------------------------------------------------------------------------
# start / stop internals (shared by start and restart)
# ---------------------------------------------------------------------------

def selected_sink(cfg: dict) -> str:
    """Pick the sink to cast to: explicit config, then cached, then target.

    Older configs stored the friendly display name in ``sink``. Resolve it back
    to the P2P/MAC address from the discovery cache when possible -- waycast
    accepts a name too, but the address is unambiguous and still works if the
    TV renames itself between scans.
    """
    explicit = str(cfg.get("sink") or "").strip()
    sinks = load_sinks()
    if explicit:
        for item in sinks:
            if item.get("name") == explicit and item.get("address"):
                return item["address"]
        return explicit
    if sinks:
        return sinks[0].get("address") or sinks[0].get("name") or ""
    return str(cfg.get("target") or "").strip()


def sink_type(sink: str) -> str:
    for item in load_sinks():
        if sink and (item.get("name") == sink or item.get("address") == sink):
            return item.get("type", "wfd")
    return "wfd"


def build_waycast_args(cfg: dict, sink: str) -> list[str]:
    """Build the full waycast argv tail (global flags first, then `daemon`).

    waycast declares ``--interface`` at the top level, before the subcommand::

        waycast --interface wlp0s20f3 daemon --sink <MAC> [--extend]

    Putting it after ``daemon`` makes clap reject the command, which looked
    exactly like "the Cast pane does nothing" in the field. The returned list
    is appended directly to the resolved binary path.
    """
    args: list[str] = []
    iface = str(cfg.get("interface") or "").strip()
    if iface:
        args += ["--interface", iface]
    args += ["daemon", "--sink", sink]
    if cfg.get("mode") == "extend":
        args.append("--extend")
    if cfg.get("codec") in {"h264", "h264-sw"}:
        args += ["--codec", cfg["codec"]]
    if not cfg.get("audio"):
        args.append("--no-audio")
    return args


def primary_monitor() -> str:
    """Return the focused Hyprland output, or the first one, without prompting."""
    hyprctl = shutil.which("hyprctl")
    if not hyprctl:
        return ""
    rc, out, _err = run([hyprctl, "monitors", "-j"], timeout=4)
    if rc != 0:
        return ""
    try:
        monitors = json.loads(out)
    except (ValueError, TypeError):
        return ""
    if not isinstance(monitors, list) or not monitors:
        return ""
    for monitor in monitors:
        if isinstance(monitor, dict) and monitor.get("focused"):
            return str(monitor.get("name", ""))
    return str(monitors[0].get("name", "")) if isinstance(monitors[0], dict) else ""


def build_fluxcast_args(cfg: dict, sink: str) -> tuple[list[str], str]:
    """Build fluxcast args; only pass a target flag we saw in --help.

    Returns (args, note).  ``--protocol``/``--transport`` are part of the
    documented contract and are always passed; target flags are detected from
    ``fluxcast --help`` so we never invent an unsupported one.
    """
    binary = find_backend("fluxcast")
    flags = supported_flags(binary)
    protocol = str(cfg.get("protocol") or "").strip().lower()
    if protocol not in {"dlna", "cast"}:
        protocol = "cast" if sink_type(sink) == "cast" else "dlna"

    args = ["--protocol", protocol]
    if protocol == "dlna":
        args += ["--transport", "hls"]

    # fluxcast otherwise prompts for a monitor on stdin, which is closed when
    # the helper owns the process. Pin it to the active Hyprland output.
    if "--monitor" in flags:
        monitor = str(cfg.get("monitor") or "").strip() or primary_monitor()
        if monitor:
            args += ["--monitor", monitor]

    # Quality presets. A full 1080p30 HLS stream makes Android TV's Cast
    # receiver drop the session; 720p20/2M is the tested-safe default.
    for flag, key in (("--fps", "fps"), ("--bitrate", "bitrate")):
        if flag in flags and cfg.get(key):
            args += [flag, str(cfg[key])]
    resolution = str(cfg.get("outputRes") or "1280x720")
    if "--output-res" in flags and RESOLUTION_MAP.get(resolution, resolution):
        args += ["--output-res", RESOLUTION_MAP.get(resolution, resolution)]

    note = ""
    target = str(cfg.get("target") or "").strip() or sink
    if target:
        # --host is the *bind* address in fluxcast, not a target, so it is
        # deliberately excluded here. prefer the cast-specific --tv-ip.
        candidates = ("--tv-ip", "--device-name") if protocol == "cast" else ("--device-name",)
        candidates += ("--target", "--device", "--url", "--address", "--sink")
        for flag in candidates:
            if flag in flags:
                args += [flag, target]
                break
        else:
            note = "fluxcast target not passed (no supported target flag found in --help)"
    return args, note


def start_session() -> tuple[bool, str]:
    """Launch the selected backend, track its PID and redirect output to log."""
    cfg = load_config()

    # Refuse a second start: a duplicate backend fails to bind the same HTTP /
    # RTSP ports and produces no playable stream (verified against a live TV).
    session = load_session()
    if session.get("active"):
        old_pid = int(session.get("pid") or 0)
        old_backend = str(session.get("backend") or "")
        if process_alive(old_pid, old_backend):
            return False, f"A cast session is already running (pid {old_pid}). Stop it first."
        # Stale session: clear it before spawning so the UI and backend agree
        # about which process owns the ports.
        atomic_write_json(SESSION_FILE, inactive_session(cfg.get("mode", "mirror")))

    backend = select_backend(cfg)
    binary = find_backend(backend)
    if not binary:
        return False, f"{backend} is not installed; cannot start cast session"
    sink = selected_sink(cfg)
    if not sink:
        return False, "no sink selected - run 'discover' first or set target/sink via apply"

    if backend == "waycast":
        args = [binary, *build_waycast_args(cfg, sink)]
        note = ""
    else:
        fc_args, note = build_fluxcast_args(cfg, sink)
        args = [binary, *fc_args]

    CAST_DIR.mkdir(parents=True, exist_ok=True)
    started = datetime.now(timezone.utc).isoformat(timespec="seconds")
    try:
        with open(LOG_FILE, "ab", buffering=0) as log:
            log.write(f"\n--- {started} end4pc-cast start: {' '.join(args)} ---\n".encode("utf-8", "replace"))
            proc = subprocess.Popen(
                args,
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                env=os.environ.copy(),
            )
    except OSError as exc:
        return False, f"failed to start {backend}: {exc}"

    session = {
        "active": True,
        "backend": backend,
        "sink": sink,
        "mode": cfg["mode"],
        "startedAt": started,
        "pid": proc.pid,
    }
    atomic_write_json(SESSION_FILE, session)
    return True, note


def stop_session() -> str:
    """Terminate the tracked backend process and clear the session file."""
    session = load_session()
    pid = int(session.get("pid") or 0)
    backend = str(session.get("backend") or "")
    note = ""
    if pid > 0:
        if not process_alive(pid, backend):
            note = "tracked process was not running"
        else:
            try:
                os.kill(pid, signal.SIGTERM)
                deadline = time.monotonic() + 3.0
                while time.monotonic() < deadline and process_alive(pid, backend):
                    time.sleep(0.1)
                if process_alive(pid, backend):
                    os.kill(pid, signal.SIGKILL)
                    note = "backend required SIGKILL"
            except (ProcessLookupError, PermissionError, OSError) as exc:
                note = f"could not signal tracked process: {exc}"
    atomic_write_json(SESSION_FILE, inactive_session(load_config()["mode"]))
    return note


