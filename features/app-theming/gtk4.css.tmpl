/* Generated by end4-pC app-theming.sh from the Material You palette.
   Do not edit by hand — edits are overwritten on the next theme apply.
   GTK4 CSS has no @define-color, so values are inlined.
   mode: {{darkmode}} */

window,
window.background,
dialog,
popover,
menuitem,
tooltip {
    background-color: #{{surface}};
    color: #{{onSurface}};
}

border,
separator {
    border-color: #{{outline}};
}

button,
button.flat {
    color: #{{onSurface}};
    border-color: #{{outline}};
}

button:checked,
button:active,
button.suggested-action {
    background-color: #{{primary}};
    color: #{{onPrimary}};
}

button:disabled {
    color: rgba(0, 0, 0, 0.35);
}

entry,
textview,
treeview,
.view {
    background-color: #{{surfaceContainer}};
    color: #{{onSurface}};
}

.view:selected,
.selection {
    background-color: #{{primary}};
    color: #{{onPrimary}};
}

entry.error,
.error {
    border-color: #{{error}};
}

headerbar,
.titlebar {
    background-color: #{{surfaceContainer}};
    color: #{{onSurface}};
}
