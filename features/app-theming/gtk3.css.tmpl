/* Generated by end4-pC app-theming.sh from the Material You palette.
   Do not edit by hand — edits are overwritten on the next theme apply.
   mode: {{darkmode}} */

@define-color md3_primary #{{primary}};
@define-color md3_on_primary #{{onPrimary}};
@define-color md3_surface #{{surface}};
@define-color md3_on_surface #{{onSurface}};
@define-color md3_surface_container #{{surfaceContainer}};
@define-color md3_outline #{{outline}};
@define-color md3_error #{{error}};

/* GTK3 application windows (Thunar, Nautilus, …) */
window.background,
window.background > .dialog,
.dialog,
popover,
popover.background,
menuitem,
tooltip,
.tooltip {
    background-color: @md3_surface;
    color: @md3_on_surface;
}

window.background .frame,
.frame {
    border-color: @md3_outline;
}

button,
button.flat {
    color: @md3_on_surface;
    border-color: @md3_outline;
}

button:checked,
button:active,
.suggested-action,
button.suggested-action {
    background-color: @md3_primary;
    color: @md3_on_primary;
}

button:disabled,
button:insensitive {
    color: alpha(@md3_on_surface, 0.4);
}

entry,
.entry,
treeview.view,
.view {
    background-color: @md3_surface_container;
    color: @md3_on_surface;
}

/* Thunar-focused selectors — icon/item hover and selection follow the palette */
.thunar .view:selected,
iconview.view:selected,
treeview.view:selected {
    background-color: @md3_primary;
    color: @md3_on_primary;
}

/* Thunar chrome: drop the separated-toolbar outline so the header bar and
   path bar read as one MD3 surface. Radius tokens are literal here because
   CSS cannot read shell QML tokens. */
.thunar toolbar,
.thunar .toolbar,
.thunar headerbar {
    border: none;
    box-shadow: none;
    border-radius: 12px;
    background-color: @md3_surface_container;
}

.thunar .path-bar,
.thunar pathbar,
.thunar .location-entry {
    border: none;
    box-shadow: none;
}

.thunar entry,
.thunar .linked entry {
    border: none;
    box-shadow: none;
    border-radius: 8px;
}

/* Thunar draws its navigation buttons as .linked > button; flatten those too. */
.thunar .linked > button,
.thunar toolbar button,
.thunar headerbar button {
    border: none;
    box-shadow: none;
    background-color: transparent;
}

entry.error,
.error {
    border-color: @md3_error;
}

headerbar,
.headerbar,
.titlebar {
    background-color: @md3_surface_container;
    color: @md3_on_surface;
}
